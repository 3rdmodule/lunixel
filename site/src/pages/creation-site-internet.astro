---
import Base from '../layouts/Base.astro';
import WorkItem from '../components/WorkItem.astro';
import FinalCta from '../components/FinalCta.astro';
import { site } from '../config.js';
import { enLigne } from '../data/projects.js';
import { metiers, metierPath } from '../data/metiers.js';
import { sources } from '../data/content.js';

const url = `${site.url}/creation-site-internet/`;

const services = [
  ['Web design', 'Une maquette à vos couleurs, pensée pour votre métier et vos clients. Pas un modèle tout fait avec votre logo posé dessus : la première maquette de votre page d’accueil est offerte.'],
  ['Développement web', 'Je code votre site sur mesure : rapide, lisible sur téléphone, sans thème ni extensions à mettre à jour sans arrêt. Il reste léger et sûr dans le temps.'],
  ['Référencement naturel', 'Titres, textes, structure des pages et données lues par Google : votre site est prêt pour les recherches de vos clients dès la mise en ligne. Je vous aide aussi avec votre fiche Google.'],
  ['Réservation et formulaires', 'Prise de rendez-vous en ligne avec Cal.com, formulaire de contact ou de devis : vos clients passent à l’action sans devoir vous appeler.'],
  ['Hébergement et nom de domaine', `L’hébergement est compris. Votre nom de domaine est à votre nom, sur votre propre compte OVH, pour ${site.domainCost}.`],
  ['Entretien et évolutions', `En option, de ${site.prices.entretien} à ${site.prices.entretienMax} par mois selon le site : petites modifications, surveillance, mises à jour. Et plus tard, des outils sur mesure si votre activité en a besoin.`],
];

const questions = [
  ['Web designer ou développeur web : vous faites les deux ?', 'Oui. Je dessine le site (web design), je le code (développement web) et je le prépare pour Google. Vous avez un seul interlocuteur du premier croquis à la mise en ligne. Les différences entre ces métiers sont expliquées dans <a class="text-link" href="/guides/web-designer-ou-developpeur/">ce guide</a>.'],
  ['Utilisez-vous WordPress ou Wix ?', 'Non. Chaque site est codé sur mesure. Il est plus rapide, il n’a pas d’extensions à mettre à jour chaque semaine, et il ne dépend pas d’un abonnement à un outil. Vous pouvez toujours me demander une modification, ou partir avec votre site si vous changez de prestataire.'],
  ['Mon site sera-t-il bien placé sur Google ?', 'Il sera construit pour : pages rapides, titres et textes qui décrivent votre activité et votre ville, données structurées, plan du site. Personne ne peut garantir une première place, mais un site bien construit, relié à une fiche Google bien remplie, part avec une longueur d’avance.'],
  ['Pouvez-vous refaire mon site actuel ?', 'Oui. Je reprends vos contenus utiles, je conserve si possible vos adresses de pages pour ne pas perdre votre référencement, et je vous livre un site neuf, plus rapide et plus clair.'],
  ['Travaillez-vous seulement près de Lille ?', `Non. Je suis basé à ${site.location.city}, ${site.location.near}, et je peux vous rencontrer dans la métropole lilloise. Pour le reste de la France, tout se fait très bien en visio et par e-mail.`],
];

const jsonld = [
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: 'Création de site internet sur mesure',
    serviceType: 'Création de site internet',
    description: 'Web design, développement web, référencement naturel, hébergement et entretien de sites internet pour artisans, commerçants, indépendants et TPE.',
    url,
    provider: { '@id': `${site.url}/#studio` },
    areaServed: [
      { '@type': 'City', name: 'Lille' },
      { '@type': 'City', name: site.location.city },
      { '@type': 'Country', name: 'France' },
    ],
    offers: [
      { '@type': 'Offer', name: 'Site d’une page', price: parseInt(site.prices.presence, 10), priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Site de plusieurs pages', price: parseInt(site.prices.vitrine, 10), priceCurrency: 'EUR' },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Création de site internet', item: url },
    ],
  },
];
---
<Base
  title="Création de site internet sur mesure près de Lille · Lunixel"
  description={`Web designer et développeur web à ${site.location.city} : design, développement, référencement et hébergement de votre site. Dès ${site.prices.presence}, maquette offerte.`}
  jsonld={jsonld}
>
  <section class="page-hero theme-nuit">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Création de site internet</li></ol></nav>
      <p class="eyebrow"><i class="px" aria-hidden="true"></i>Web design · Développement · Référencement</p>
      <h1 class="h-1 display">Création de site internet sur mesure, du dessin à Google</h1>
      <p class="lead">Je dessine, je développe et je mets en ligne le site de votre entreprise, puis je l’aide à être trouvé. <strong>Un seul interlocuteur, un prix écrit, un site qui vous appartient.</strong></p>
      <div class="cta-row"><a class="btn" href="/contact/">{site.cta}</a><a class="arrow-link" href="/tarifs/">Voir les tarifs</a></div>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Ce que je fais</p>
        <h2 id="services-title" class="h-2">Tout ce dont votre site a besoin, au même endroit</h2>
        <p class="lead">Vous n’avez pas à coordonner un designer, un développeur et un hébergeur. Je m’occupe de tout, et je vous explique chaque étape simplement.</p>
      </div>
      <div class="besoins">
        {services.map(([t, d], i) => (
          <div class="besoin" data-reveal>
            <p class="pilier__n"><i class="px" aria-hidden="true"></i>0{i + 1}</p>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section theme-nuit" aria-labelledby="pourqui-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Pour qui</p>
        <h2 id="pourqui-title" class="h-2">Pour les petites entreprises qui ont mieux à faire que le web</h2>
        <p class="lead">Instituts, salons, praticiens du bien-être, boutiques, artisans, indépendants : si vos clients vous cherchent en ligne, votre site doit leur répondre vite.</p>
      </div>
      <p class="links-row" style="margin-top:0" data-reveal>
        <span class="soft">Par métier :</span>
        <a class="arrow-link" href="/salons/">Salons et instituts</a>
        {metiers.map((m) => <a class="arrow-link" href={metierPath(m)}>{m.label}</a>)}
      </p>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="prix-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Prix</p>
        <h2 id="prix-title" class="h-2">Combien coûte la création de votre site</h2>
      </div>
      <div class="prose">
      <p>Un site d’une page commence à <strong>{site.prices.presence}</strong>, un site de plusieurs pages à <strong>{site.prices.vitrine}</strong>, payés une fois. Les outils sur mesure sont sur devis. À titre de comparaison, un freelance facture en général de 800 à 3 000 € HT, une agence de 2 000 à 6 000 € HT (<a href={sources.prixAgence.url} rel="noopener">{sources.prixAgence.label}</a>).</p>
      <p>Pourquoi si peu ? Je travaille seul, sans locaux ni commerciaux, avec des outils qui me font gagner beaucoup de temps. Tout est expliqué sur la page <a href="/tarifs/">Tarifs</a> et dans le guide <a href="/guides/prix-site-internet/">Combien coûte un site internet en 2026 ?</a></p>
      </div>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="preuves-title" style="padding-top:0">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Réalisations</p>
        <h2 id="preuves-title" class="h-2">Des sites déjà en ligne</h2>
      </div>
      <div class="work-list">
        {enLigne.slice(0, 2).map((p) => <WorkItem project={p} />)}
      </div>
      <p style="margin-top:var(--s-5)"><a class="arrow-link" href="/realisations/">Toutes les réalisations</a></p>
    </div>
  </section>

  <section class="section theme-nuit" aria-labelledby="local-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Près de chez vous</p>
        <h2 id="local-title" class="h-2">Un web designer à {site.location.city}, près de Lille</h2>
      </div>
      <div class="prose">
      <p>Je travaille depuis {site.location.city}. Si votre activité est dans la métropole lilloise, à Lille, Roubaix, Tourcoing, Marcq-en-Barœul ou ailleurs, on peut se rencontrer pour parler de votre projet ou prendre des photos. Ailleurs en France, tout se fait par visio et par e-mail, avec la même méthode : <a href="/methode/">démo gratuite, devis écrit, mise en ligne en {site.delay} environ</a>.</p>
      </div>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="questions-title">
    <div class="container faq">
      <div class="section-head">
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Questions</p>
        <h2 id="questions-title" class="h-2">Ce qu’on me demande souvent</h2>
        <p class="lead">Une autre question ? <a class="text-link" href="/faq/">Toutes les questions fréquentes</a>.</p>
      </div>
      <div class="faq__list">
        {questions.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p set:html={a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <FinalCta title="Parlons du site de votre entreprise." />
</Base>
