---
import Base from '../layouts/Base.astro';
import Besoins from '../components/Besoins.astro';
import Formules from '../components/Formules.astro';
import Methode from '../components/Methode.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Vitrine from '../components/Vitrine.astro';
import Status from '../components/Status.astro';
import { projects } from '../data/projects.js';
import { metiers, metierPath } from '../data/metiers.js';
const nube = projects.find((p) => p.slug === 'nube-games');
---
<Base
  title="Création de site internet, hébergement et suivi · Lunixel"
  description="Site d’une ou plusieurs pages, référencement local, hébergement, suivi chaque mois et outils sur mesure, pour artisans, commerçants et TPE."
>
  <section class="page-hero theme-nuit">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Services</li></ol></nav>
      <h1 class="h-1 display">Création de sites internet, et tout ce qui va avec</h1>
      <p class="lead">Je conçois le site, je l’écris avec vous, je le mets en ligne et je m’en occupe ensuite. <strong>Vous n’avez qu’une personne à appeler.</strong></p>
      <div class="cta-row"><a class="btn" href="/contact/">Parler de mon projet</a><a class="arrow-link" href="#formules">Voir les formules</a></div>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="besoins-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Vos besoins</p>
        <h2 id="besoins-title" class="h-2">Ce que vous voulez obtenir</h2>
        <p class="lead">Je pars de là, pas de la technique. Si un mot vous paraît technique, touchez « En clair ».</p>
      </div>
      <Besoins detailed />
      <p class="metiers-links" data-reveal>
        <span class="soft">Par métier :</span>
        {metiers.map((m) => <a class="arrow-link" href={metierPath(m)}>{m.label}</a>)}
      </p>
    </div>
  </section>

  <section class="section theme-nuit" aria-labelledby="outils-title">
    <div class="container work">
      <div class="work__media lightable" data-light>
        <Vitrine project={nube} variant={'jeu'} alt="Le jeu Fields of Fire, développé par Lunixel, dans le navigateur" />
      </div>
      <div class="work__body" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Outils sur mesure et applications web</p>
        <h2 id="outils-title" class="h-2">Quand un site ne suffit plus</h2>
        <p class="soft">Réservation, catalogue, espace client, outil interne : je développe ce dont votre activité a besoin. Jusqu’à de vraies applications, comme <strong style="color:var(--fg)">Fields of Fire</strong>, un jeu de société jouable en ligne de 3 à 6 joueurs.</p>
        <Status kind="realisation" />
        <a class="arrow-link" href="/realisations/nube-games/">Voir l’étude de cas Nube Games</a>
      </div>
    </div>
  </section>

  <section class="section theme-jour" id="formules" style="background:var(--papier-ombre);--surface:var(--papier)" aria-labelledby="formules-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Formules</p>
        <h2 id="formules-title" class="h-2">Les formules</h2>
        <p class="lead">Voici les prix de départ. Après notre premier appel, gratuit, vous recevez un devis écrit, et c’est ce prix-là que vous payez.</p>
      </div>
      <Formules />
    </div>
  </section>

  <Methode id="methode-services" title="Du premier appel à la mise en ligne" />
  <Faq full title="Vos questions, mes réponses" />
  <FinalCta title="Un site, c’est souvent deux semaines. Commençons par 30 minutes." lead="Un premier appel gratuit pour comprendre votre activité et vous dire ce que je ferais." />
</Base>

<style>
  .metiers-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-5);
  }
</style>
