---
import Base from '../../layouts/Base.astro';
import Vitrine from '../../components/Vitrine.astro';
import Status from '../../components/Status.astro';
import FinalCta from '../../components/FinalCta.astro';
import { guideBySlug, guidePath } from '../../data/guides.js';
import { metiers, metierPath } from '../../data/metiers.js';
import { projects, projectPath, linkLabel } from '../../data/projects.js';
import { site } from '../../config.js';

export function getStaticPaths() {
  return metiers.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const exemple = m.exemple ? projects.find((p) => p.slug === m.exemple) : null;
const autres = metiers.filter((x) => x.slug !== m.slug);
const url = `${site.url}${metierPath(m)}`;
const contact = `/contact/?activite=${m.activite}`;
const jsonld = [
  {
    '@type': 'Service',
    name: m.title.replace(' · Lunixel', ''),
    serviceType: 'Création de site internet',
    description: m.description,
    url,
    provider: { '@id': `${site.url}/#studio` },
    areaServed: { '@type': 'Country', name: 'France' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: m.label, item: url },
    ],
  },
];
---
<Base title={m.title} description={m.description} jsonld={jsonld}>
  <section class="page-hero theme-nuit">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">{m.label}</li></ol></nav>
      <p class="eyebrow"><i class="px" aria-hidden="true"></i>Site internet · {m.label}</p>
      <h1 class="h-1 display">{m.h1}</h1>
      <p class="lead">{m.lead}</p>
      <div class="cta-row"><a class="btn" href={contact}>{site.cta}</a><a class="arrow-link" href="/tarifs/">Voir les tarifs</a></div>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="besoins-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>L’essentiel</p>
        <h2 id="besoins-title" class="h-2">Ce que votre site doit faire</h2>
      </div>
      <div class="besoins">
        {m.besoins.map(([t, d], i) => (
          <div class="besoin" data-reveal>
            <p class="pilier__n"><i class="px" aria-hidden="true"></i>0{i + 1}</p>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {exemple && (
    <section class="section theme-nuit" aria-labelledby="exemple-title">
      <div class="container work">
        <a class="work__media lightable" href={projectPath(exemple)} tabindex="-1" aria-hidden="true" data-light>
          <Vitrine project={exemple} alt={`Aperçu du site ${exemple.name}`} />
        </a>
        <div class="work__body" data-reveal>
          <Status kind={exemple.kind} state={exemple.status} />
          <h2 id="exemple-title" class="h-3">{exemple.name}</h2>
          <p class="soft">{m.exempleTexte}</p>
          <a class="arrow-link" href={projectPath(exemple)}>{linkLabel(exemple)}<span class="sr-only"> : {exemple.name}</span></a>
        </div>
      </div>
    </section>
  )}

  <section class="section theme-jour" aria-labelledby="questions-title">
    <div class="container faq">
      <div class="section-head">
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Questions</p>
        <h2 id="questions-title" class="h-2">Vos questions</h2>
        <p class="lead">Une autre question ? <a class="text-link" href="/faq/">Toutes les questions fréquentes</a>.</p>
      </div>
      <div class="faq__list">
        {m.faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
    <div class="container">
      <p class="soft autres">Vous êtes plutôt :
        {autres.map((x, i) => (<>{i > 0 && ' · '}<a class="text-link" href={metierPath(x)}>{x.label}</a></>))}
        · <a class="text-link" href="/salons/">Salons et instituts</a>
      </p>
      {m.guides?.length > 0 && (
        <p class="soft autres">À lire :
          {m.guides.map(guideBySlug).filter(Boolean).map((g, i) => (<>{i > 0 && ' · '}<a class="text-link" href={guidePath(g)}>{g.h1}</a></>))}
        </p>
      )}
    </div>
  </section>

  <FinalCta title={m.final} />
</Base>

<style>
  .autres {
    margin-top: var(--s-6);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
  }
</style>
