---
import Base from '../layouts/Base.astro';
import Vitrine from '../components/Vitrine.astro';
import Status from '../components/Status.astro';
import Stats from '../components/Stats.astro';
import FinalCta from '../components/FinalCta.astro';
import Plateformes from '../components/Plateformes.astro';
import { projects, projectPath, linkLabel } from '../data/projects.js';
import { metiers, metierPath } from '../data/metiers.js';
import { site } from '../config.js';

const exemple = projects.find((p) => p.slug === 'fabienne-hiot');
const features = [
  ['Réservation en ligne 24 h/24', 'Un agenda Cal.com intégré à votre site et relié à votre téléphone. Vos clients choisissent leur créneau, vous recevez la réservation.'],
  ['Confirmation par e-mail', 'Vos clients reçoivent une confirmation automatique. Des rappels par SMS sont possibles en option, avec un petit coût par message.'],
  ['Services et tarifs clairs', 'Vos services, leur durée et leur prix, lisibles sur téléphone. Plus besoin d’appeler pour savoir.'],
  ['Vos photos et vos avis', 'Vos réalisations et vos avis Google, là où vos futurs clients les cherchent.'],
  ['Visible sur Google', 'Votre site est construit pour apparaître quand on cherche « onglerie à Lille » ou « massage près de chez moi ».'],
  ['Sans commission', 'Pour une personne seule, la réservation en ligne est gratuite. Plusieurs employés ? Je vous indique l’option la moins chère.'],
];
const url = `${site.url}/salons/`;
const jsonld = [
  {
    '@type': 'Service',
    name: 'Site internet pour salons de beauté, coiffure et bien-être',
    serviceType: 'Création de site internet avec réservation en ligne',
    url,
    provider: { '@id': `${site.url}/#studio` },
    areaServed: { '@type': 'Country', name: 'France' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Salons et instituts', item: url },
    ],
  },
];
---
<Base
  title="Site internet pour institut, onglerie, coiffure et bien-être · Lunixel"
  description="Un site qui remplit votre agenda : services, prix, photos et réservation en ligne 24 h/24 avec Cal.com, sans commission. Démo gratuite."
  jsonld={jsonld}
>
  <section class="page-hero theme-nuit">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Salons et instituts</li></ol></nav>
      <p class="eyebrow"><i class="px" aria-hidden="true"></i>Instituts · Ongleries · Coiffure · Massage · Bien-être</p>
      <h1 class="h-1 display">Un site qui remplit votre agenda, sans commission</h1>
      <p class="lead">Vos clients voient vos services, vos prix et vos photos, puis réservent en deux clics, même en dehors de vos horaires. <strong>Et vous ne reversez rien à personne.</strong></p>
      <div class="cta-row"><a class="btn" href="/contact/?activite=beaute">{site.cta}</a><a class="arrow-link" href="/tarifs/">Voir les tarifs</a></div>
    </div>
  </section>

  <section class="section theme-jour" aria-labelledby="chiffres-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Pourquoi c’est important</p>
        <h2 id="chiffres-title" class="h-2">Vos clients réservent aussi quand vous êtes occupé</h2>
      </div>
      <Stats only={[1, 2]} />
    </div>
  </section>

  <Plateformes />

  <section class="section theme-jour" aria-labelledby="fonctions-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Fonctionnalités</p>
        <h2 id="fonctions-title" class="h-2">Ce que contient votre site</h2>
      </div>
      <div class="besoins">
        {features.map(([t, d], i) => (
          <div class="besoin" data-reveal>
            <p class="pilier__n"><i class="px" aria-hidden="true"></i>0{i + 1}</p>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section theme-nuit" aria-labelledby="exemple-title">
    <div class="container work">
      <a class="work__media lightable" href={projectPath(exemple)} tabindex="-1" aria-hidden="true" data-light>
        <Vitrine project={exemple} alt={`Aperçu du site ${exemple.name}`} />
      </a>
      <div class="work__body" data-reveal>
        <Status kind={exemple.kind} state={exemple.status} />
        <h2 id="exemple-title" class="h-3">Un exemple : {exemple.name}, {exemple.business.toLowerCase()}</h2>
        <p class="soft">Les soins et leurs tarifs dès l’accueil, le premier contact gratuit mis en avant, et un bouton « Rendez-vous » toujours visible.</p>
        <a class="arrow-link" href={projectPath(exemple)}>{linkLabel(exemple)}<span class="sr-only"> : {exemple.name}</span></a>
      </div>
    </div>
  </section>

  <section class="section theme-jour" aria-label="Par métier">
    <div class="container">
      <p class="links-row" style="margin-top:0" data-reveal>
        <span class="soft">Par métier :</span>
        {metiers.map((m) => <a class="arrow-link" href={metierPath(m)}>{m.label}</a>)}
      </p>
    </div>
  </section>

  <FinalCta title="Voyons à quoi ressemblerait le site de votre salon." />
</Base>
