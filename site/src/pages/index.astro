---
import Base from '../layouts/Base.astro';
import Vitrine from '../components/Vitrine.astro';
import Status from '../components/Status.astro';
import WorkItem from '../components/WorkItem.astro';
import ConceptCard from '../components/ConceptCard.astro';
import Stats from '../components/Stats.astro';
import FinalCta from '../components/FinalCta.astro';
import { projects, realisations, concepts, enLigne, isWip } from '../data/projects.js';
import { outcomes, gains, demoSteps } from '../data/content.js';
import { metiers, metierPath } from '../data/metiers.js';
import { site } from '../config.js';

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
// Ordre d'affichage : la première est au fond, la deuxième au premier plan, la troisième sur téléphone.
const heroShots = [
  { p: bySlug['3rd-records'], variant: 'desktop' },
  { p: bySlug['fabienne-hiot'], variant: 'desktop' },
  { p: bySlug['le-domaine-musical'], variant: 'phone' },
];
// Ordre des travaux : le site mis en avant (Fabienne Hiot) et les sites en cours en grand,
// puis les concepts (Le Domaine Musical, Hugo Abecassis), puis les autres sites déjà en ligne.
const vedettes = realisations.filter((p) => p.slug === 'fabienne-hiot' || isWip(p));
const autresEnLigne = enLigne.filter((p) => !vedettes.includes(p));
---
<Base
  title="Lunixel · Création de site internet pour salons et boutiques"
  description="Des sites sur mesure qui prennent vos rendez-vous et vous amènent des clients. Payés une fois, sans commission. Maquette de votre page d’accueil offerte."
  assembleLogo
>
  <!-- 1. Ouverture -->
  <section class="hero theme-nuit" data-hero aria-labelledby="hero-title">
    <div class="hero__halo" aria-hidden="true"></div>
    <div class="container grid hero__grid">
      <div class="hero__head">
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Sites internet pour salons, instituts et boutiques</p>
        <h1 id="hero-title" class="h-hero display">Vous avez un <span class="lumiere">métier</span>.<br />Je m’occupe du web.</h1>
      </div>
      <div class="hero__sub">
        <p class="lead">Un site à votre image, qui prend vos rendez-vous et vous amène des clients. <strong>Payé une fois, et il est à vous.</strong></p>
        <ul class="outcomes" role="list" aria-label="Ce que vous y gagnez">
          {outcomes.map((o) => (
            <li><b>{o.value}</b><span>{o.href ? <a href={o.href}>{o.text}</a> : o.text}</span></li>
          ))}
        </ul>
        <div class="cta-row">
          <a class="btn" href="/contact/">{site.cta}</a>
          <a class="arrow-link" href="#travaux">Voir des exemples</a>
        </div>
        <p class="reassure"><span><i class="px" aria-hidden="true"></i>Maquette de votre page d’accueil offerte</span><span>Sans engagement</span></p>
      </div>
      <div class="hero__visual">
        <div class="vitrines" role="region" aria-label="Quelques travaux du studio" tabindex="0">
          {heroShots.map(({ p, variant }, i) => (
            <figure class:list={['lightable', { 'is-phone': variant === 'phone' }]} data-hero-light>
              <a href={`/${p.kind === 'realisation' ? 'realisations' : 'concepts'}/${p.slug}/`} tabindex="-1" aria-hidden="true">
                <Vitrine project={p} variant={variant} eager={i === 1} barLabel={p.name} barKind={p.kind} barState={p.status} sizes={variant === 'phone' ? '(min-width: 64rem) 12rem, 46vw' : '(min-width: 64rem) 42vw, 80vw'} />
              </a>
              <figcaption><span>{p.name}</span><Status kind={p.kind} state={p.status} short /></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="daybreak" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

  <!-- 2. Le constat -->
  <section class="section theme-jour" aria-labelledby="constat-title" style="padding-top:clamp(3rem,2rem + 4vw,6rem)">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>01 · Le constat</p>
        <h2 id="constat-title" class="h-2">Vos clients vous cherchent en ligne. Beaucoup de sites coûtent cher et ne rapportent rien.</h2>
        <p class="lead">Des milliers d’euros pour un site, un abonnement chaque mois, une commission sur chaque nouveau client : on peut faire autrement.</p>
      </div>
      <Stats />
      <p class="links-row" data-reveal><a class="arrow-link" href="/tarifs/#comparatif">Comparer avec une agence ou une plateforme</a></p>
    </div>
  </section>

  <!-- 3. Ce que vous y gagnez -->
  <section class="section theme-jour" aria-labelledby="gains-title" style="padding-top:0">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>02 · Ce que ça change</p>
        <h2 id="gains-title" class="h-2">Ce que vous y gagnez</h2>
      </div>
      <div class="gains">
        {gains.map((g, i) => (
          <div class="pilier" data-reveal>
            <p class="pilier__n"><i class="px" aria-hidden="true"></i>0{i + 1}</p>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. La démo gratuite -->
  <section class="section theme-jour" style="background:var(--papier-ombre);--surface:var(--papier)" aria-labelledby="demo-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>03 · La démo gratuite</p>
        <h2 id="demo-title" class="h-2">La maquette de votre page d’accueil, offerte</h2>
        <p class="lead">Vous voyez à quoi ressemblera votre site avant de décider quoi que ce soit.</p>
      </div>
      <ol class="demo-steps" role="list">
        {demoSteps.map((d, i) => (
          <li class="pilier" data-reveal>
            <p class="pilier__n"><i class="px" aria-hidden="true"></i>0{i + 1}</p>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </li>
        ))}
      </ol>
      <div class="cta-row" style="margin-top:var(--s-5)">
        <a class="btn btn--dark" href="/contact/">{site.cta}</a>
        <a class="arrow-link" href="/methode/">Et ensuite ? La méthode</a>
      </div>
    </div>
  </section>

  <!-- 5. Travaux -->
  <section class="section theme-nuit" id="travaux" aria-labelledby="travaux-title">
    <div class="container">
      <div class="work-head" data-reveal>
        <div class="section-head" style="margin:0">
          <p class="eyebrow"><i class="px" aria-hidden="true"></i>04 · Travaux</p>
          <h2 id="travaux-title" class="h-2">Des sites qui ressemblent à ceux qui les tiennent</h2>
          <p class="lead">Chaque site commence par une maquette, comme celle de la démo gratuite.</p>
        </div>
        <div class="legend">
          <Status kind="realisation" />
          {realisations.some(isWip) && <Status kind="realisation" state="en-cours" />}
          <Status kind="concept" />
        </div>
      </div>
      <div class="work-list">
        {vedettes.map((p) => <WorkItem project={p} />)}
      </div>
      <div class="concept-grid concept-grid--duo">
        <div class="section-head" style="grid-column:1/-1;margin-bottom:var(--s-2)" data-reveal>
          <h3 class="h-3">Imaginés pour de vrais commerces</h3>
          <p class="soft" style="max-width:52ch">Des concepts faits sans commande, pour montrer ce qu’un magasin ou un artisan pourrait avoir en ligne.</p>
        </div>
        {concepts.map((p) => <ConceptCard project={p} />)}
      </div>
      <div class="concept-grid concept-grid--duo">
        <div class="section-head" style="grid-column:1/-1;margin-bottom:var(--s-2)" data-reveal>
          <h3 class="h-3">Et déjà en ligne</h3>
          <p class="soft" style="max-width:52ch">Des sites livrés, que vous pouvez visiter aujourd’hui.</p>
        </div>
        {autresEnLigne.map((p) => <ConceptCard project={p} />)}
      </div>
      <div class="cta-row" style="margin-top:var(--s-6)">
        <a class="arrow-link" href="/realisations/">Toutes les réalisations</a>
        <a class="arrow-link" href="/concepts/">Tous les concepts</a>
      </div>
    </div>
  </section>

  <!-- 6. Pour qui -->
  <section class="section theme-jour" aria-labelledby="pour-qui-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>05 · Pour qui</p>
        <h2 id="pour-qui-title" class="h-2">Pour les métiers où tout commence par un rendez-vous</h2>
        <p class="lead">Instituts, ongleries, coiffeurs, masseurs, naturopathes et boutiques de quartier.</p>
      </div>
      <ul class="metier-list" role="list">
        {metiers.map((m) => (
          <li data-reveal>
            <a href={metierPath(m)}>
              <span class="metier-list__name">{m.label}</span>
              <span class="metier-list__text">{m.h1}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="links-row" data-reveal><a class="arrow-link" href="/salons/">Vous travaillez sur rendez-vous ? La réservation en ligne, sans commission</a></p>
      <p class="soft" style="margin-top:var(--s-3);max-width:60ch" data-reveal>Votre métier n’est pas dans la liste ? Je crée aussi des sites pour les artisans, les indépendants et les petites entreprises : <a class="text-link" href="/contact/">parlons-en</a>.</p>
    </div>
  </section>

  <!-- 7. Appel final -->
  <FinalCta />
</Base>
