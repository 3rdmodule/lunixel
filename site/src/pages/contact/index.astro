---
import Base from '../../layouts/Base.astro';
import { site, socials, telHref, whatsappHref } from '../../config.js';
import { activites, projetTypes, budgets } from '../../data/content.js';
const delais = [['vite', 'Dès que possible'], ['3-mois', 'Dans les 3 mois'], ['pas-presse', 'Pas pressé']];
const action = site.web3formsKey ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`;
---
<Base
  title="Démo gratuite · La maquette de votre site offerte · Lunixel"
  description={`Quatre questions, deux minutes : je vous prépare la maquette de votre page d’accueil, offerte et sans engagement. Réponse sous ${site.responseTime}.`}
  mobileCta={false}
>
  <section class="page-hero theme-nuit" style="padding-bottom:var(--section)">
    <div class="container contact-layout">
      <div class="contact-aside">
        <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Contact</li></ol></nav>
        <h1 class="h-1 display">Votre démo <span class="lumiere">gratuite</span>.</h1>
        <p class="lead">Quatre questions, deux minutes. Je vous prépare la maquette de votre page d’accueil, <strong>offerte et sans engagement.</strong></p>
        <div>
          <p class="eyebrow" style="margin-bottom:var(--s-2)"><i class="px" aria-hidden="true"></i>Et ensuite ?</p>
          <ol class="next-steps" role="list">
            <li><span>Je lis votre demande moi-même et je vous réponds sous {site.responseTime}.</span></li>
            <li><span>Je prépare la maquette de votre page d’accueil, à vos couleurs.</span></li>
            <li><span>Elle vous plaît ? On en parle. Sinon, vous ne me devez rien.</span></li>
          </ol>
        </div>
        {site.bookingUrl && (
          <div class="booking">
            <p class="soft">Vous préférez choisir directement un créneau ?</p>
            <a class="btn btn--ghost" href={site.bookingUrl} rel="noopener" target="_blank">Réserver un appel de 30 min<span class="sr-only"> (nouvel onglet)</span></a>
          </div>
        )}
        {(telHref || whatsappHref) && (
          <div class="direct">
            <p class="soft">Vous préférez en parler de vive voix ?</p>
            <div class="direct__links">
              {telHref && <a class="btn btn--ghost" href={telHref}>Appeler le {site.phone.display}</a>}
              {whatsappHref && <a class="btn btn--ghost" href={whatsappHref} rel="noopener" target="_blank">Écrire sur WhatsApp<span class="sr-only"> (nouvel onglet)</span></a>}
            </div>
          </div>
        )}
        <p class="soft">Vous préférez écrire directement ?<br /><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>{socials.length > 0 && <>, ou en message sur {socials.map((s, i) => <>{i > 0 && (i === socials.length - 1 ? ' ou ' : ', ')}<a class="text-link" href={s.url} rel="noopener me" target="_blank">{s.name}<span class="sr-only"> (nouvel onglet)</span></a></>)}</>}.</p>
      </div>

      <form class="form" action={action} method="post" enctype={site.web3formsKey ? undefined : 'text/plain'} data-contact-form data-key={site.web3formsKey || undefined} data-to={site.email} novalidate>
        {site.web3formsKey && (<>
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="redirect" value="https://lunixel.fr/contact/merci/" />
          <input type="hidden" name="subject" value="Demande de démo depuis lunixel.fr" />
        </>)}
        <div class="form__progress" aria-hidden="true">
          <ol data-progress><li></li><li></li><li></li><li></li></ol>
          <span data-counter>Étape 1 sur 4</span>
        </div>
        <p class="sr-only" aria-live="polite" data-counter-live></p>

        <fieldset data-step="activite" class="is-current">
          <legend>Votre activité<small>Choisissez ce qui vous ressemble le plus.</small></legend>
          <div class="choice-list">
            {activites.map(([v, l]) => (
              <label class="choice"><input type="radio" name="activite" value={v} data-label={l} required /><span>{l}</span></label>
            ))}
          </div>
          <p class="error" data-error-for="activite" role="alert"></p>
        </fieldset>

        <fieldset data-step="projet">
          <legend>Votre projet<small>Une seule réponse, vous pourrez tout préciser ensuite.</small></legend>
          <div class="choice-list">
            {projetTypes.map(([v, l]) => (
              <label class="choice"><input type="radio" name="projet" value={v} data-label={l} required /><span>{l}</span></label>
            ))}
          </div>
          <p class="error" data-error-for="projet" role="alert"></p>
        </fieldset>

        <fieldset data-step="details">
          <legend>En quelques mots<small>Tout est facultatif ici.</small></legend>
          <div class="field">
            <label for="lien">Votre site actuel, votre Instagram ou votre fiche Google</label>
            <input id="lien" name="lien" type="text" inputmode="url" autocomplete="url" placeholder="Ex. : instagram.com/votre-institut" />
          </div>
          <div class="field">
            <label for="message">Votre activité, vos envies, vos questions</label>
            <textarea id="message" name="message" rows="5" placeholder="Ex. : J’ai une onglerie à Roubaix, j’aimerais que mes clients voient mes réalisations et réservent en ligne sans passer par une plateforme."></textarea>
          </div>
          <div class="field">
            <span class="label" id="delai-l">Quand aimeriez-vous être en ligne ?</span>
            <div class="choice-list" role="radiogroup" aria-labelledby="delai-l">
              {delais.map(([v, l]) => (<label class="choice"><input type="radio" name="delai" value={v} data-label={l} /><span>{l}</span></label>))}
            </div>
          </div>
          <div class="field">
            <span class="label" id="budget-l">Avez-vous une idée de budget ?</span>
            <div class="choice-list" role="radiogroup" aria-labelledby="budget-l">
              {budgets.map(([v, l]) => (<label class="choice"><input type="radio" name="budget" value={v} data-label={l} /><span>{l}</span></label>))}
            </div>
          </div>
        </fieldset>

        <fieldset data-step="contact">
          <legend>Pour vous répondre<small>Un e-mail ou un téléphone, au choix.</small></legend>
          <div class="field-row">
            <div class="field">
              <label for="prenom">Prénom</label>
              <input id="prenom" name="prenom" autocomplete="given-name" required aria-describedby="err-prenom" />
              <p class="error" id="err-prenom" data-error-for="prenom" role="alert"></p>
            </div>
            <div class="field">
              <label for="entreprise">Entreprise <span class="soft">(facultatif)</span></label>
              <input id="entreprise" name="entreprise" autocomplete="organization" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">E-mail</label>
              <input id="email" name="email" type="email" inputmode="email" autocomplete="email" aria-describedby="err-email" />
              <p class="error" id="err-email" data-error-for="email" role="alert"></p>
            </div>
            <div class="field">
              <label for="telephone">Téléphone</label>
              <input id="telephone" name="telephone" type="tel" inputmode="tel" autocomplete="tel" />
            </div>
          </div>
          <label class="check"><input type="checkbox" name="rappel" value="oui" /> <span>Je préfère être rappelé(e)</span></label>
          <input class="honey" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="form__legal">Vos informations servent uniquement à vous répondre. <a href="/confidentialite/">En savoir plus</a>.</p>
        </fieldset>

        <div class="form__nav">
          <button class="btn" type="button" data-prev hidden>← Retour</button>
          <button class="btn" type="button" data-next>Continuer</button>
          <button class="btn" type="submit" data-submit><span class="label">Recevoir ma démo</span><span class="loader" aria-hidden="true"><i></i><i></i><i></i></span></button>
        </div>
        <p class="form__status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .direct {
    display: grid;
    gap: var(--s-1);
  }
  .direct__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .booking {
    display: grid;
    gap: var(--s-1);
    justify-items: start;
  }
</style>
