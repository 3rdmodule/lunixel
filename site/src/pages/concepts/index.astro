---
import Base from '../../layouts/Base.astro';
import ConceptCard from '../../components/ConceptCard.astro';
import Status from '../../components/Status.astro';
import FinalCta from '../../components/FinalCta.astro';
import { concepts } from '../../data/projects.js';
---
<Base
  title="Concepts de sites pour artisans et commerces · Lunixel"
  description="Des sites imaginés par Lunixel pour un luthier, un magasin de musique et une naturopathe, sans commande, pour explorer leur métier en ligne."
>
  <section class="page-hero theme-nuit">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Concepts</li></ol></nav>
      <h1 class="h-1 display">Avant de construire, j’imagine</h1>
      <p class="lead">J’ai imaginé ces sites pour de vrais commerces et artisans, <strong>sans qu’ils me le demandent</strong>. C’est ma façon de montrer comment je réfléchis à un métier avant de dessiner quoi que ce soit.</p>
      <div class="concept-banner"><Status kind="concept" /><span>Un concept n’est pas un site livré : il n’a pas été commandé par l’entreprise concernée, et n’est pas son site officiel.</span></div>
    </div>
  </section>
  <section class="section theme-nuit" style="padding-top:0" aria-label="Les concepts">
    <div class="container">
      <div class="concept-grid" style="margin-top:0;border-top:0;padding-top:0">
        {concepts.map((p) => <ConceptCard project={p} headingLevel="h2" />)}
      </div>
    </div>
  </section>
  <FinalCta title="Et si j’imaginais le vôtre ?" lead="Racontez-moi votre métier, je vous montre ce qu’il pourrait devenir en ligne." />
</Base>
