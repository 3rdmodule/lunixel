---
import Base from '../layouts/Base.astro';
import Formules from '../components/Formules.astro';
import Comparatif from '../components/Comparatif.astro';
import FinalCta from '../components/FinalCta.astro';
import { site } from '../config.js';
import { entretien } from '../data/content.js';

const presence = parseInt(site.prices.presence, 10);
const prestation = 40;
const rdv = presence ? Math.ceil(presence / prestation) : null;
const jsonld = [
  {
    '@type': 'OfferCatalog',
    name: 'Tarifs Lunixel',
    url: `${site.url}/tarifs/`,
    itemListElement: [
      site.prices.presence && { '@type': 'Offer', name: 'Présence : site d’une page', priceCurrency: 'EUR', price: parseInt(site.prices.presence, 10), priceSpecification: { '@type': 'PriceSpecification', minPrice: parseInt(site.prices.presence, 10), priceCurrency: 'EUR' } },
      site.prices.vitrine && { '@type': 'Offer', name: 'Vitrine : site de plusieurs pages', priceCurrency: 'EUR', price: parseInt(site.prices.vitrine, 10), priceSpecification: { '@type': 'PriceSpecification', minPrice: parseInt(site.prices.vitrine, 10), priceCurrency: 'EUR' } },
    ].filter(Boolean),
  },
];
---
<Base
  title="Tarifs · Site internet payé une fois, sans commission · Lunixel"
  description={`Site d’une page dès ${site.prices.presence}, site complet dès ${site.prices.vitrine}, payé une fois et à vous. Entretien en option dès ${site.prices.entretien} par mois. Maquette offerte.`}
  jsonld={jsonld}
>
  <section class="page-hero theme-nuit">
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="/">Accueil</a></li><li aria-current="page">Tarifs</li></ol></nav>
      <h1 class="h-1 display">Des prix clairs, payés une fois</h1>
      <p class="lead">Le site est à vous, sans commission sur vos rendez-vous. <strong>La maquette de votre page d’accueil est offerte.</strong></p>
    </div>
  </section>

  <section class="section theme-jour" style="background:var(--papier-ombre);--surface:var(--papier)" aria-labelledby="formules-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Formules</p>
        <h2 id="formules-title" class="h-2">Les prix de départ</h2>
        <p class="lead">Après notre premier appel, gratuit, vous recevez un devis écrit, et c’est ce prix-là que vous payez.</p>
      </div>
      <Formules />
      {site.legal.vat && <p class="soft" style="margin-top:var(--s-3);font-size:var(--step--1)">Prix nets : {site.legal.vat}.</p>}
      <div class="duo">
        {rdv && (
          <div class="note-box" data-reveal>
            <p class="eyebrow"><i class="px" aria-hidden="true"></i>Vite remboursé</p>
            <p class="big">Un site d’une page à {site.prices.presence}, c’est {rdv} rendez-vous à {prestation} €.</p>
            <p class="soft">Ensuite, chaque client qui vous trouve ou réserve en ligne, c’est du chiffre en plus.</p>
          </div>
        )}
        <div class="note-box" data-reveal>
          <p class="eyebrow"><i class="px" aria-hidden="true"></i>Après la mise en ligne</p>
          <p class="big">Rien d’obligatoire à payer chaque mois.</p>
          <p class="soft">L’hébergement est compris. Seul votre nom de domaine est à renouveler, {site.domainCost} : il est réservé chez OVH, sur un compte à votre nom. Un souci ? Je réponds {site.support}.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section theme-jour" id="entretien" aria-labelledby="entretien-title">
    <div class="container duo" style="margin-top:0;align-items:start">
      <div class="section-head" style="margin:0" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>En option</p>
        <h2 id="entretien-title" class="h-2">L’entretien, si vous le souhaitez</h2>
        <p class="lead">Je veille sur votre site chaque semaine et je fais vos petites modifications, pour que vous n’ayez plus à y penser.</p>
      </div>
      <article class="formule" data-reveal>
        <h3>{entretien.name}</h3>
        <p class="formule__price">De <strong>{site.prices.entretien}</strong> à <strong>{site.prices.entretienMax}</strong> par mois</p>
        <ul role="list">
          {entretien.items.map((it) => <li><i class="px" aria-hidden="true"></i>{it}</li>)}
        </ul>
        <p>{entretien.note}</p>
      </article>
    </div>
  </section>

  <section class="section theme-jour" style="padding-top:0" id="comparatif" aria-labelledby="comparatif-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><i class="px" aria-hidden="true"></i>Comparer</p>
        <h2 id="comparatif-title" class="h-2">Ce que vous payez ailleurs</h2>
        <p class="lead">Les chiffres des autres options viennent de sources publiques, citées sous le tableau.</p>
      </div>
      <Comparatif />
      <p class="links-row"><a class="arrow-link" href="/faq/">Toutes les questions fréquentes</a><a class="arrow-link" href="/methode/">Comment ça se passe</a><a class="arrow-link" href="/guides/prix-site-internet/">Guide : combien coûte un site en 2026</a></p>
    </div>
  </section>

  <FinalCta title="Commencez par la démo gratuite." lead="Vous voyez la maquette de votre page d’accueil avant de décider quoi que ce soit." />
</Base>
