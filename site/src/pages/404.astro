---
import Base from '../layouts/Base.astro';
import Moon from '../components/Moon.astro';
---
<Base title="Page introuvable · Lunixel" description="Cette page est restée dans l’ombre. Retrouvez les réalisations, les tarifs ou demandez votre démo gratuite sur lunixel.fr." mobileCta={false} noindex>
  <script is:inline>
    // GitHub Pages ne sert que ce 404 racine : sous /concept/<nom>/, on affiche le 404 propre au concept.
    (function () {
      var m = location.pathname.match(/^\/concept\/([^\/]+)\//);
      if (!m) return;
      var root = document.documentElement;
      root.style.visibility = 'hidden';
      fetch('/concept/' + m[1] + '/404.html')
        .then(function (r) { if (!r.ok) throw r.status; return r.text(); })
        .then(function (html) { document.open(); document.write(html); document.close(); })
        .catch(function () { root.style.visibility = ''; });
    })();
  </script>
  <section class="lost theme-nuit">
    <div class="lost__inner">
      <Moon assemble />
      <p class="eyebrow">Erreur 404</p>
      <h1 class="h-1 display">Cette page est restée dans l’ombre.</h1>
      <p class="lead">Elle a peut-être changé d’adresse. Reprenons depuis un repère connu.</p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn" href="/">Retour à l’accueil</a>
        <a class="arrow-link" href="/contact/">Obtenir ma démo gratuite</a>
      </div>
    </div>
  </section>
</Base>
