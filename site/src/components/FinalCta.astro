---
import { site } from '../config.js';
interface Props { title?: string; lead?: string }
const {
  title = 'Voyons à quoi pourrait ressembler votre site.',
  lead = 'Présentez-moi votre activité : je vous prépare la maquette de votre page d’accueil, offerte et sans engagement.',
} = Astro.props;
---
<section class="final theme-profonde" aria-labelledby="final-title" data-final>
  <div class="final__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="final__inner" data-reveal>
      <p class="eyebrow"><i class="px" aria-hidden="true"></i>Démo gratuite</p>
      <h2 id="final-title" class="display">{title}</h2>
      <p class="lead">{lead}</p>
      <div class="cta-row">
        <a class="btn" href="/contact/">{site.cta}</a>
        {site.bookingUrl ? <a class="arrow-link" href={site.bookingUrl} rel="noopener" target="_blank">Réserver un appel<span class="sr-only"> (nouvel onglet)</span></a> : <a class="arrow-link" href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
      <p class="reassure"><span><i class="px" aria-hidden="true"></i>Maquette offerte, sans engagement</span><span>Réponse sous {site.responseTime}</span><span>Aucune commission</span></p>
    </div>
  </div>
</section>
