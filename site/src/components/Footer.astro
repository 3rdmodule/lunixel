---
import Logo from './Logo.astro';
import { site } from '../config.js';
import { metiers, metierPath } from '../data/metiers.js';
const year = new Date().getFullYear();
---
<footer class="site-footer theme-profonde">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo label="Lunixel" />
        <p>{site.signature}</p>
        <p class="footer-where">Basé à {site.location.city}, {site.location.near}. Je travaille partout en France.</p>
      </div>
      <div class="footer-cols">
        <div>
          <p class="footer-title">Le site</p>
          <ul>
            <li><a href="/realisations/">Réalisations</a></li>
            <li><a href="/concepts/">Concepts</a></li>
            <li><a href="/tarifs/">Tarifs</a></li>
            <li><a href="/methode/">Méthode</a></li>
            <li><a href="/a-propos/">À propos</a></li>
            <li><a href="/faq/">Questions fréquentes</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-title">Pour qui</p>
          <ul>
            <li><a href="/salons/">Salons et instituts</a></li>
            {metiers.map((m) => <li><a href={metierPath(m)}>{m.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer-title">Contact</p>
          <ul>
            <li><a href="/contact/">{site.cta}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {site.bookingUrl && <li><a href={site.bookingUrl} rel="noopener" target="_blank">Réserver un appel<span class="sr-only"> (nouvel onglet)</span></a></li>}
          </ul>
        </div>
        <div>
          <p class="footer-title">Informations</p>
          <ul>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
            <li><a href="/confidentialite/">Confidentialité</a></li>
            <li><a href="/confidentialite/#cookies">Cookies</a></li>
            <li><a href="/conditions/">Conditions d’utilisation</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Lunixel · Conçu et développé par Lunixel</span>
      <span class="perf" data-perf hidden><i class="px" aria-hidden="true"></i><span data-perf-text></span></span>
    </div>
    <p class="footer-powered">Powered by <a href="https://3rdmodule.com/" rel="noopener">3rdModule</a></p>
  </div>
</footer>

<style>
  .footer-title {
    font-family: var(--f-label);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-soft);
    margin: 0 0 var(--s-2);
  }
  .footer-where {
    font-size: var(--step--1);
  }
  .footer-powered {
    margin-top: var(--s-2);
    font-family: var(--f-label);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--fg-soft);
    opacity: 0.8;
  }
  .footer-powered a {
    color: inherit;
    text-decoration: none;
  }
  .footer-powered a:hover,
  .footer-powered a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
