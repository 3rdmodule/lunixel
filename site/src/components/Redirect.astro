---
// Ancienne adresse : renvoie vers la nouvelle (GitHub Pages ne gère pas les redirections serveur).
import { site } from '../config.js';
interface Props { to: string }
const { to } = Astro.props;
const url = new URL(to, site.url).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>Page déplacée · Lunixel</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>Cette page a déménagé : <a href={to}>{url}</a></p>
  </body>
</html>
