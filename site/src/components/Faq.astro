---
import { faq, faqPlus } from '../data/content.js';
interface Props { full?: boolean; id?: string }
const { full = false, id = 'questions' } = Astro.props;
const items = full ? [...faq, ...faqPlus] : faq;
---
<section class="section theme-jour" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq">
    <div class="section-head">
      <p class="eyebrow"><i class="px" aria-hidden="true"></i>Questions</p>
      <h2 id={`${id}-title`} class="h-2">Les questions qu’on nous pose souvent.</h2>
      <p class="lead">Une autre question ? <a class="text-link" href="/contact/">Posez-la nous</a>, on répond à tout.</p>
    </div>
    <div class="faq__list">
      {items.map((it) => (
        <details>
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
