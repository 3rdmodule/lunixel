---
import { faq, faqPlus } from '../data/content.js';
import { site } from '../config.js';
interface Props { full?: boolean; id?: string; title?: string }
const { full = false, id = 'questions', title = 'Vos questions avant de vous lancer' } = Astro.props;
const items = full ? [...faq, ...faqPlus] : faq;
---
<section class="section theme-jour" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq">
    <div class="section-head">
      <p class="eyebrow"><i class="px" aria-hidden="true"></i>Questions</p>
      <h2 id={`${id}-title`} class="h-2">{title}</h2>
      <p class="lead">Une autre question ? <a class="text-link" href="/contact/">Écrivez-moi</a>, je réponds sous {site.responseTime}.</p>
    </div>
    <div class="faq__list">
      {items.map((it) => (
        <details>
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
