---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config.js';
import fs from 'node:fs';
import nodePath from 'node:path';

interface Props {
  title: string;
  description: string;
  og?: string;
  jsonld?: object[];
  mobileCta?: boolean;
  assembleLogo?: boolean;
  noindex?: boolean;
}
const { title, description, og, jsonld = [], mobileCta = true, assembleLogo = false, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const ogExists = (s) => fs.existsSync(nodePath.join(process.cwd(), 'public/generated/og', `${s}.jpg`));
const wanted = og ?? (path === '/' ? 'accueil' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-'));
const ogSlug = ogExists(wanted) ? wanted : ogExists('accueil') ? 'accueil' : null;
const ogImage = ogSlug ? new URL(`/generated/og/${ogSlug}.jpg`, site.url).href : null;
const graph = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#studio`,
    name: 'Lunixel',
    url: `${site.url}/`,
    email: site.email,
    description: site.description,
    slogan: site.signature,
    logo: `${site.url}/favicon.svg`,
    areaServed: { '@type': 'Country', name: 'France' },
    knowsLanguage: 'fr',
  },
  { '@type': 'WebSite', '@id': `${site.url}/#site`, url: `${site.url}/`, name: 'Lunixel', inLanguage: 'fr-FR', publisher: { '@id': `${site.url}/#studio` } },
  ...jsonld,
];
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1B1E3C" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/generated/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/generated/icons/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Lunixel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body class:list={['theme-nuit', { 'has-mobile-cta': mobileCta }]}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header path={path} assemble={assembleLogo} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {mobileCta && (
      <div class="mobile-cta" data-mobile-cta aria-hidden="true">
        <a class="btn btn--block" href="/contact/" tabindex="-1">Parler de mon projet</a>
      </div>
    )}
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
