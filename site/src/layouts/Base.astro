---
import '@fontsource-variable/gabarito/wght.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, socials, whatsappHref } from '../config.js';
import fs from 'node:fs';
import nodePath from 'node:path';

interface Props {
  title: string;
  description: string;
  og?: string;
  jsonld?: object[];
  mobileCta?: boolean;
  assembleLogo?: boolean;
  noindex?: boolean;
  ogType?: string;
}
const { title, description, og, jsonld = [], mobileCta = true, assembleLogo = false, noindex = false, ogType = 'website' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const ogExists = (s) => fs.existsSync(nodePath.join(process.cwd(), 'public/generated/og', `${s}.jpg`));
const wanted = og ?? (path === '/' ? 'accueil' : path.replace(/^\/|\/$/g, '').replace(/\//g, '-'));
const ogSlug = ogExists(wanted) ? wanted : ogExists('accueil') ? 'accueil' : null;
const ogImage = ogSlug ? new URL(`/generated/og/${ogSlug}.jpg`, site.url).href : null;
const graph = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#studio`,
    name: 'Lunixel',
    url: `${site.url}/`,
    email: site.email,
    ...(site.phone?.intl ? { telephone: site.phone.intl } : {}),
    ...(site.phone?.intl ? { contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', telephone: site.phone.intl, email: site.email, availableLanguage: 'French', areaServed: 'FR' } } : {}),
    description: site.description,
    slogan: site.signature,
    logo: `${site.url}/generated/icons/icon-512.png`,
    image: `${site.url}/generated/og/accueil.jpg`,
    address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressRegion: site.location.region, addressCountry: 'FR' },
    areaServed: [
      { '@type': 'City', name: site.location.city },
      { '@type': 'City', name: 'Lille' },
      { '@type': 'AdministrativeArea', name: 'Métropole européenne de Lille' },
      { '@type': 'Country', name: 'France' },
    ],
    priceRange: `À partir de ${site.prices.presence}`,
    currenciesAccepted: 'EUR',
    knowsLanguage: 'fr',
    knowsAbout: ['Création de site internet', 'Web design', 'Développement web', 'Référencement naturel', 'Réservation en ligne'],
    founder: { '@id': `${site.url}/#awen` },
    ...(site.bookingUrl ? { potentialAction: { '@type': 'ReserveAction', target: site.bookingUrl, name: 'Réserver un appel' } } : {}),
    ...(socials.length ? { sameAs: socials.map((s) => s.url) } : {}),
  },
  {
    '@type': 'Person',
    '@id': `${site.url}/#awen`,
    name: site.legal.publisher,
    jobTitle: 'Web designer et développeur web',
    url: `${site.url}/a-propos/`,
    worksFor: { '@id': `${site.url}/#studio` },
  },
  { '@type': 'WebSite', '@id': `${site.url}/#site`, url: `${site.url}/`, name: 'Lunixel', alternateName: ['Lunixel studio web', 'lunixel.fr'], inLanguage: 'fr-FR', publisher: { '@id': `${site.url}/#studio` } },
  ...jsonld,
];
---
<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification?.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    <meta name="theme-color" content="#1B1E3C" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/generated/icons/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/generated/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/generated/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/generated/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Lunixel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body class:list={['theme-nuit', { 'has-mobile-cta': mobileCta }]}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header path={path} assemble={assembleLogo} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {mobileCta && (
      <div class="mobile-cta" data-mobile-cta aria-hidden="true">
        <a class="btn btn--block" href="/contact/" tabindex="-1">{site.cta}</a>
        {whatsappHref && (
          <a class="btn btn--ghost mobile-cta__wa" href={whatsappHref} rel="noopener" target="_blank" tabindex="-1" aria-label="Écrire sur WhatsApp (nouvel onglet)">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
          </a>
        )}
      </div>
    )}
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
