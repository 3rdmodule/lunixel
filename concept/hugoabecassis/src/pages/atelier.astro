---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import BookingLink from '../components/BookingLink.astro';
import type { PhotoId } from '../data/photos';

const steps: PhotoId[] = ['e1', 'e2', 'e3', 'e4', 'e5', 'e6', 'e7', 'e8'];
const details: PhotoId[] = ['physalisChevillier', 'volute2015', 'etabliDetail', 'physalisOuie', 'volute2016', 'laJazzTete', 'pinarboxCaisse', 'physalisFond'];
---

<Base
  title="L'atelier"
  description="L’établi d’Hugo Abecassis, ses outils à main, et des étapes de fabrication photographiées à l’établi, de juillet 2015 à janvier 2016."
  breadcrumbs={[{ name: 'Atelier', path: '/atelier/' }]}
>
  <header class="container page-head">
    <h1>L'atelier</h1>
    <p class="lead">Un établi, des outils à main, des instruments en cours. Voici à quoi ressemble le travail, de près.</p>
  </header>

  <section class="container opening" aria-label="L'établi">
    <div class="opening__main"><Photo id="etabli" eager sizes="(min-width: 900px) 64vw, 100vw" caption lightbox /></div>
    <div class="opening__side"><Photo id="portrait" sizes="(min-width: 900px) 30vw, 100vw" caption lightbox /></div>
  </section>

  <section class="section container tone-sable" aria-labelledby="steps-title">
    <div class="index">
      <div class="index__head">
        <h2 id="steps-title" class="index__title">Étapes de fabrication</h2>
        <p class="index__intro">Photos prises à l'établi entre juillet 2015 et janvier 2016 : du moule au vernis.</p>
      </div>
      <ol class="index__body steps">
        {
          steps.map((id, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <Photo id={id} ratio={1} sizes="(min-width: 900px) 20vw, 50vw" caption lightbox />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section container" aria-labelledby="details-title">
    <div class="index">
      <div class="index__head">
        <h2 id="details-title" class="index__title">De près</h2>
        <p class="index__intro">Volutes, chevilles, ouïes, bois. Cliquez pour agrandir.</p>
      </div>
      <ul class="index__body details">
        {details.map((id) => <li><Photo id={id} ratio={1} sizes="(min-width: 900px) 16vw, 50vw" caption lightbox /></li>)}
      </ul>
    </div>
  </section>

  <section class="section container tone-garance" aria-labelledby="visit-title">
    <div class="visit">
      <h2 id="visit-title">Passer à l'atelier</h2>
      <p class="muted">Sur rendez-vous, avec votre instrument.</p>
      <BookingLink event="diagnostic" />
    </div>
  </section>
</Base>

<style>
  .opening { display: grid; gap: var(--col-gap); }
  @media (min-width: 900px) {
    .opening { grid-template-columns: 2fr 1fr; align-items: end; }
  }

  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px var(--col-gap); list-style: none; padding: 0; margin: 0; }
  .step { position: relative; }
  .step__num {
    position: absolute; z-index: 1; top: 8px; left: 8px;
    min-width: 28px; height: 28px; display: grid; place-items: center;
    background: var(--etiquette); color: var(--encre); border: 1px solid var(--encre);
    font-family: var(--font-label), Georgia, serif; font-size: 0.85rem;
  }
  @media (min-width: 700px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px var(--col-gap); list-style: none; padding: 0; margin: 0; }
  @media (min-width: 900px) { .details { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .visit { display: grid; gap: 16px; justify-items: start; }
  .visit h2 { font-size: var(--fs-h1); }
</style>
