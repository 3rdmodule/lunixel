---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import SectionHead from '../../components/SectionHead.astro';
import CreationCard from '../../components/CreationCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import BookingLink from '../../components/BookingLink.astro';
import Tbc from '../../components/Tbc.astro';
import { services, type Service } from '../../data/services';
import { creations } from '../../data/creations';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service: s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
const faqLd = s.faq?.filter((f) => !f.tbc).length
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: s.faq.filter((f) => !f.tbc).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ]
  : [];
let n = 1;
const next = () => String(++n).padStart(2, '0');
---

<Base
  title={s.seo.title}
  description={s.seo.description}
  breadcrumbs={[{ name: 'Savoir-faire', path: '/savoir-faire/' }, { name: s.title, path: `/savoir-faire/${s.slug}/` }]}
  jsonLd={faqLd}
>
  <section class="container svc-hero">
    <div class="svc-hero__text">
      <nav class="page-intro__meta" aria-label="Fil d'Ariane">
        <a class="label" href={url('/savoir-faire/')}>Savoir-faire</a>
        <span class="num">{s.number}</span>
      </nav>
      <h1>{s.title}</h1>
      <p class="label svc-hero__kicker">{s.kicker}</p>
      <p class="lead svc-hero__lead">{s.lead}</p>
      <div class="svc-hero__body">
        {s.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="row mt-m">
        <BookingLink motif={s.motif} />
      </div>
    </div>
    <div class="svc-hero__photo">
      <Photo id={s.photo} sizes="(min-width: 900px) 45vw, 100vw" eager caption plate={`Pl. ${s.number}`} />
    </div>
  </section>

  <section class="section" aria-labelledby="items-title">
    <div class="container">
      <SectionHead number={next()} label={s.title} title={s.itemsTitle} id="items-title">
        {s.validate && <p><Tbc note="liste à valider avec Hugo" /></p>}
      </SectionHead>
      <ul class="def-list">
        {
          s.items.map((item) => (
            <li>
              <span class="def-list__title">{item.title}</span>
              <span class="def-list__text">{item.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    s.steps && s.slug !== 'fabrication' && (
      <section class="section tone-papier" aria-labelledby="steps-title">
        <div class="container">
          <SectionHead number={next()} label="Déroulé" title="Comment ça se passe" id="steps-title">
            <p><Tbc note="déroulé à valider avec Hugo" /></p>
          </SectionHead>
          <ol class="steps steps--row">
            {s.steps.map((st) => (
              <li>
                <span class="steps__title">{st.title}</span>
                <span class="steps__text">{st.text}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    s.slug === 'restauration' && (
      <section class="section" aria-labelledby="example-title">
        <div class="container grid example">
          <div class="example__photo">
            <Photo id="fender" sizes="(min-width: 900px) 40vw, 100vw" caption plate="Ex. 01" />
          </div>
          <div class="example__body">
            <SectionHead number={next()} label="Un exemple" title="Remise en forme d'une Fender Precision Bass de 1973" id="example-title" level="h2" />
            <p class="muted">
              Une basse électrique de 1973, remise en forme à l'atelier. Le détail de l'intervention sera présenté ici avec
              les photos avant et après. <Tbc note="détail de l'intervention, photos" />
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    s.slug === 'fabrication' && (
      <>
        <section class="section tone-papier" aria-labelledby="steps-title">
          <div class="container">
            <SectionHead number={next()} label="Déroulé" title="D'une conversation à un instrument" id="steps-title">
              <p><Tbc note="déroulé à valider avec Hugo" /></p>
            </SectionHead>
            <ol class="steps steps--row">
              {s.steps?.map((st) => (
                <li>
                  <span class="steps__title">{st.title}</span>
                  <span class="steps__text">{st.text}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>
        <section class="section" id="creations" aria-labelledby="creations-title">
          <div class="container">
            <SectionHead number={next()} label="Créations" title="Instruments réalisés" id="creations-title">
              <p>Instruments du répertoire, instruments anciens, formes nouvelles.</p>
            </SectionHead>
            <div class="creations">
              {creations.map((c, i) => (
                <CreationCard creation={c} plate={`C. ${String(i + 1).padStart(2, '0')}`} showYearTbc={c.featured} />
              ))}
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    s.faq && (
      <section class="section" aria-labelledby="faq-title">
        <div class="container grid faq-wrap">
          <div class="faq-wrap__head">
            <SectionHead number={next()} label="Questions" title="Questions fréquentes" id="faq-title" />
          </div>
          <div class="faq faq-wrap__list">
            {s.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div>
                  <p>
                    {f.a} {f.tbc && <Tbc />}
                  </p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section--tight container" aria-label="Autres savoir-faire">
    <p class="label">Voir aussi</p>
    <ul class="others">
      {
        others.map((o) => (
          <li>
            <a href={url(`/savoir-faire/${o.slug}/`)}>
              <span class="num">{o.number}</span>
              <span class="serif others__title">{o.title}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand motif={s.motif} />
</Base>

<style>
  .svc-hero { display: grid; gap: var(--space-l); padding-top: calc(var(--header-h) + clamp(48px, 8vw, 120px)); padding-bottom: var(--space-section); }
  .svc-hero__text { display: grid; align-content: start; }
  .svc-hero__text .page-intro__meta a { text-decoration: none; }
  .svc-hero__kicker { margin-top: 16px; }
  .svc-hero__lead { margin-top: var(--space-m); max-width: 24ch; }
  .svc-hero__body { margin-top: var(--space-m); max-width: 40ch; color: var(--muted); }
  @media (min-width: 900px) {
    .svc-hero { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: start; }
    .svc-hero__text { grid-column: 1 / 7; }
    .svc-hero__photo { grid-column: 8 / 13; position: sticky; top: calc(var(--header-h) + 24px); }
  }

  .example { row-gap: var(--space-m); align-items: end; }
  .example__photo, .example__body { grid-column: 1 / -1; }
  .example__body :global(.section-head) { margin-bottom: var(--space-m); }
  .example__body :global(h2) { max-width: 20ch; }
  @media (min-width: 900px) {
    .example__photo { grid-column: 1 / 6; }
    .example__body { grid-column: 7 / 12; }
  }

  .creations { display: grid; gap: clamp(64px, 8vw, 104px) var(--col-gap); }
  @media (min-width: 700px) { .creations { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .creations { grid-template-columns: repeat(3, 1fr); } }

  .faq-wrap { row-gap: var(--space-m); }
  .faq-wrap__head, .faq-wrap__list { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .faq-wrap__head { grid-column: 1 / 5; }
    .faq-wrap__list { grid-column: 6 / 13; }
  }

  .others { list-style: none; border-top: 1px solid var(--line); margin-top: 16px; }
  .others a { display: flex; align-items: baseline; gap: 18px; padding-block: 18px; border-bottom: 1px solid var(--line); text-decoration: none; }
  .others__title { font-size: clamp(1.8rem, 1.4rem + 1.5vw, 2.6rem); line-height: 1; flex: 1; }
  .others .arrow { transition: transform 300ms var(--ease); }
  .others a:hover .arrow { transform: translateX(6px); }
</style>
