---
import Base from '../layouts/Base.astro';
import Tbc from '../components/Tbc.astro';
import Etiquette from '../components/Etiquette.astro';
import BookingLink from '../components/BookingLink.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

const { email, phone, city, area, hours } = site.contact;
const objets = [
  { value: 'entretien', label: 'Entretien, réglage' },
  { value: 'restauration', label: 'Restauration, réparation' },
  { value: 'fabrication', label: "Fabrication d'un instrument" },
  { value: 'autre', label: 'Autre question' },
];
const instruments = ['Violon', 'Alto', 'Violoncelle', 'Contrebasse', 'Guitare', 'Autre instrument'];
---

<Base
  title="Contact et rendez-vous"
  description="Rendez-vous et contact : Hugo Abecassis, luthier en Normandie. Entretien, restauration ou fabrication d'un instrument à cordes."
  breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
>
  <header class="container page-head">
    <h1>Contact</h1>
    <p class="lead">L'instrument, ce qui ne va pas, vos disponibilités : quelques lignes suffisent.</p>
  </header>

  <section class="section container contact">
    <div class="contact__side">
      <div class="block" id="rendez-vous">
        <h2>Prendre rendez-vous</h2>
        <p class="muted">L'atelier reçoit sur rendez-vous. Choisissez un créneau en ligne : premier rendez-vous (diagnostic, devis), réglage, ou dépôt d'un instrument.</p>
        <BookingLink label="Voir les créneaux" />
      </div>

      <div class="block">
        <h2>L'atelier</h2>
        <Etiquette title="Hugo Abecassis" kind="luthier" maker={false} meta={city ? `${city} · ${area}` : area} size="sm" />
        <dl class="coords">
          <div><dt>Adresse</dt><dd>{city || <Tbc note="adresse de l'atelier" />}</dd></div>
          <div><dt>Téléphone</dt><dd>{phone ? <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a> : <Tbc />}</dd></div>
          <div><dt>E-mail</dt><dd>{email ? <a href={`mailto:${email}`}>{email}</a> : <Tbc />}</dd></div>
          <div><dt>Accueil</dt><dd>{hours || <>Sur rendez-vous <Tbc note="jours" /></>}</dd></div>
        </dl>
      </div>
    </div>

    <form class="form" id="formulaire" data-contact-form data-endpoint={site.form.endpoint} action={site.form.endpoint || undefined} method="post" novalidate>
      <h2>Écrire un message</h2>
      <div class="form__row">
        <div class="field">
          <label for="f-nom">Nom</label>
          <input id="f-nom" name="nom" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="field">
          <label for="f-email">E-mail</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
      </div>
      <div class="form__row">
        <div class="field">
          <label for="f-instrument">Instrument</label>
          <select id="f-instrument" name="instrument" required>
            <option value="" disabled selected>Choisir</option>
            {instruments.map((i) => <option value={i}>{i}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-objet">Votre demande</label>
          <select id="f-objet" name="objet" required>
            {objets.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <label for="f-message">Message</label>
        <textarea id="f-message" name="message" required maxlength="4000" placeholder="L'instrument, ce qui ne va pas, vos disponibilités…"></textarea>
      </div>
      <div class="field">
        <label for="f-tel">Téléphone <span class="hint">(facultatif, si vous préférez être rappelé)</span></label>
        <input id="f-tel" name="telephone" type="tel" autocomplete="tel" maxlength="30" />
      </div>
      <div class="honey" aria-hidden="true">
        <label for="f-site">Ne pas remplir</label>
        <input id="f-site" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>
      <p class="small muted">Vos informations servent uniquement à vous répondre. Voir la <a href={url('/confidentialite/')}>politique de confidentialité</a>.</p>
      <div class="form__foot">
        <button class="btn" type="submit"><span>Envoyer</span><span class="arrow" aria-hidden="true">→</span></button>
        <p class="form__status small" data-form-status role="status" aria-live="polite"></p>
      </div>
      {!site.form.endpoint && <p class="small"><Tbc note="service d'envoi du formulaire à brancher" /></p>}
    </form>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 56px var(--col-gap); padding-top: 0; }
  .contact__side { display: grid; gap: 40px; align-content: start; }
  .block { display: grid; gap: 14px; justify-items: start; padding-top: 18px; border-top: 1px solid var(--fg); }
  .block h2, .form h2 { font-size: var(--fs-h3); }
  .coords { display: grid; gap: 0; width: 100%; margin: 4px 0 0; border-top: 1px solid var(--line); }
  .coords > div { display: grid; grid-template-columns: 110px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  .coords dt { color: var(--muted); }
  .coords dd { margin: 0; }

  .form { display: grid; gap: 22px; padding-top: 18px; border-top: 1px solid var(--fg); position: relative; }
  .form__row { display: grid; gap: 22px; }
  @media (min-width: 640px) { .form__row { grid-template-columns: 1fr 1fr; } }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .form__status:empty { display: none; }
  .form__status[data-kind='error'] { color: var(--accent); }

  @media (min-width: 960px) {
    .contact { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .contact__side { grid-column: 1 / 5; }
    .form { grid-column: 6 / 13; }
  }
</style>
