---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <section class="page-intro container nf">
    <div class="page-intro__meta"><span class="num">404</span><span class="label">Page introuvable</span></div>
    <h1>Cette page s'est désaccordée.</h1>
    <p class="lead">Elle n'existe pas, ou elle a changé de place.</p>
    <div class="row mt-l">
      <a class="btn" href={url('/')}>Revenir à l'accueil <span class="arrow" aria-hidden="true">→</span></a>
      <a class="link" href={url('/contact/')}>Contact <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 80svh; }
</style>
