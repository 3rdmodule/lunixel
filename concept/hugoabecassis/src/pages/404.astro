---
import Base from '../layouts/Base.astro';
import Etiquette from '../components/Etiquette.astro';
import { url } from '../lib/url';
---

<Base title="Page introuvable" description="Cette page n'existe pas ou a changé d'adresse.">
  <section class="container page-head nf">
    <Etiquette title="404" kind="page introuvable" maker={false} size="md" as="h1" />
    <p class="lead">Cette page n'existe pas, ou elle a changé d'adresse.</p>
    <div class="actions">
      <a class="btn" href={url('/')}>Retour à l'accueil <span class="arrow" aria-hidden="true">→</span></a>
      <a class="link" href={url('/contact/')}>Contact <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 70svh; display: grid; align-content: start; justify-items: start; gap: 24px; }
</style>
