---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PressList from '../components/PressList.astro';
import BookingLink from '../components/BookingLink.astro';
import Tbc from '../components/Tbc.astro';
import { steps, quote } from '../data/parcours';
import { press } from '../data/press';
---

<Base
  title="Parcours et presse"
  description="Formé en Belgique auprès du luthier Gauthier Louppe, puis à Avranches et à Saint-Lô : le parcours d'Hugo Abecassis et ce qu'en dit la presse."
  breadcrumbs={[{ name: 'Parcours', path: '/parcours/' }]}
>
  <header class="container page-head intro">
    <div class="intro__text">
      <h1>Parcours</h1>
      <p class="lead">De la Belgique à la Normandie, en cinq étapes.</p>
      <blockquote class="quote">
        <p>« {quote.text} »</p>
        <footer class="caption">{quote.author}</footer>
      </blockquote>
    </div>
    <div class="intro__photo"><Photo id="portrait" eager sizes="(min-width: 900px) 34vw, 100vw" caption /></div>
  </header>

  <section class="section container tone-sable" aria-label="Étapes">
    <ol class="steps">
      {
        steps.map((s) => (
          <li class="step">
            <p class="step__when">{s.when}</p>
            <div class="step__body">
              <h2 class="step__place">{s.place}</h2>
              <p>
                {s.text} {s.tbc && <Tbc note={s.tbc} />}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container" id="presse" aria-labelledby="press-title">
    <div class="index">
      <div class="index__head">
        <h2 id="press-title" class="index__title">Dans la presse</h2>
        <p class="index__intro">Les articles d'origine, chez leurs éditeurs.</p>
      </div>
      <div class="index__body"><PressList items={press} /></div>
    </div>
  </section>

  <section class="section container tone-garance" aria-labelledby="end-title">
    <div class="end">
      <h2 id="end-title">Un instrument à faire voir&nbsp;?</h2>
      <BookingLink />
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; gap: 32px var(--col-gap); }
  .intro__text { display: grid; gap: 18px; align-content: start; }
  .quote { margin: 18px 0 0; padding-left: 18px; border-left: 2px solid var(--accent); max-width: 40ch; }
  .quote p { font-family: var(--font-label), Georgia, serif; font-style: italic; font-size: 1.2rem; line-height: 1.45; }
  .quote footer { margin-top: 8px; font-style: normal; }
  @media (min-width: 900px) {
    .intro { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; }
    .intro__text { grid-column: 1 / 7; }
    .intro__photo { grid-column: 8 / 13; }
  }

  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--fg); }
  .step { display: grid; gap: 8px var(--col-gap); padding: 22px 0 26px; border-bottom: 1px solid var(--line); }
  .step__when { font-family: var(--font-label), Georgia, serif; font-size: 1.05rem; color: var(--accent); }
  .step__place { font-size: var(--fs-h3); margin-bottom: 8px; }
  .step__body p { max-width: 58ch; }
  @media (min-width: 900px) {
    .step { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .step__when { grid-column: 1 / 4; }
    .step__body { grid-column: 4 / 11; }
  }
  .end { display: grid; gap: 24px; justify-items: start; }
  .end h2 { font-size: var(--fs-h1); max-width: 18ch; }
</style>
