---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import PressList from '../components/PressList.astro';
import CtaBand from '../components/CtaBand.astro';
import Tbc from '../components/Tbc.astro';
import { chapters, quote } from '../data/parcours';
---

<Base
  title="Parcours et presse"
  description="Formé en Belgique auprès du luthier Gauthier Louppe, installé en Normandie : le parcours d'Hugo Abecassis et ce qu'en dit la presse."
  breadcrumbs={[{ name: 'Parcours', path: '/parcours/' }]}
>
  <section class="container parcours-intro">
    <div class="parcours-intro__text">
      <div class="page-intro__meta"><span class="num">—</span><span class="label">Parcours</span></div>
      <h1>De la Belgique à la Normandie</h1>
      <p class="lead">Apprendre le métier, ouvrir un atelier, inventer quelques instruments. Le parcours d'Hugo en cinq étapes.</p>
    </div>
    <div class="parcours-intro__photo">
      <Photo id="portrait" sizes="(min-width: 900px) 35vw, 100vw" eager caption plate="Pl. 01" />
    </div>
  </section>

  <section class="section" aria-label="Chapitres du parcours">
    <div class="container">
      <ol class="story">
        {
          chapters.map((c) => (
            <li class="story__chapter">
              <div class="story__aside">
                <span class="num">{c.number}</span>
                <span class="label">{c.place}</span>
                {c.when && <span class="story__when f-display">{c.when}</span>}
              </div>
              <div class="story__body" data-reveal-text>
                <h2 class="story__title">{c.title}</h2>
                {c.text.map((p) => <p>{p}</p>)}
                {c.tbc && <p><Tbc note={c.tbc} /></p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section--tight container quote-wrap" aria-label="Citation">
    <span class="ame-divider" aria-hidden="true"></span>
    <blockquote class="quote">
      <p class="f-display">« {quote.text} »</p>
      <footer class="label">{quote.author}</footer>
    </blockquote>
  </section>

  <section class="section" id="presse" aria-labelledby="press-title">
    <div class="container">
      <SectionHead number="—" label="Dans la presse" title="Ce qu'en dit la presse" id="press-title">
        <p>Articles et références publiques, avec un lien vers chaque source originale.</p>
      </SectionHead>
      <PressList />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .parcours-intro { display: grid; gap: var(--space-l); padding-top: calc(var(--header-h) + clamp(56px, 10vw, 140px)); }
  .parcours-intro h1 { max-width: 12ch; }
  .parcours-intro .lead { margin-top: var(--space-m); max-width: 28ch; color: var(--muted); }
  @media (min-width: 900px) {
    .parcours-intro { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: end; }
    .parcours-intro__text { grid-column: 1 / 8; padding-bottom: var(--space-l); }
    .parcours-intro__photo { grid-column: 9 / 13; }
  }

  .story { list-style: none; }
  .story__chapter { display: grid; gap: 20px; padding-block: clamp(48px, 7vw, 96px); border-top: 1px solid var(--line); }
  .story__aside { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; }
  .story__when { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.6rem); line-height: 1; color: var(--muted); flex-basis: 100%; margin-top: 8px; }
  .story__body { max-width: 42ch; }
  .story__title { font-size: var(--fs-h2); margin-bottom: 24px; }
  .story__body p { color: var(--muted); font-size: calc(var(--fs-body) * 1.06); }
  @media (min-width: 900px) {
    .story__chapter { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
    .story__aside { grid-column: 1 / 5; flex-direction: column; align-items: flex-start; }
    .story__when { flex-basis: auto; }
    .story__body { grid-column: 6 / 12; }
  }

  .quote-wrap { display: grid; justify-items: center; gap: var(--space-m); text-align: center; }
  .quote { margin: 0; display: grid; gap: 24px; justify-items: center; }
  .quote p { font-size: clamp(1.6rem, 1.1rem + 2vw, 2.8rem); line-height: 1.12; max-width: 26ch; }
</style>
