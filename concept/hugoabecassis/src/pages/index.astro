---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Etiquette from '../components/Etiquette.astro';
import BookingLink from '../components/BookingLink.astro';
import PressList from '../components/PressList.astro';
import { services } from '../data/services';
import { creations } from '../data/creations';
import { press } from '../data/press';
import { url } from '../lib/url';
import type { PhotoId } from '../data/photos';

const thumbs: Record<string, PhotoId> = { entretien: 'laJazzTete', restauration: 'rPresses', fabrication: 'e4' };
const shown = creations.filter((c) => c.photo).slice(0, 3);
---

<Base
  rawTitle
  title="Hugo Abecassis, luthier en Normandie · entretien, restauration, fabrication"
  description="Hugo Abecassis, luthier en Normandie : entretien, restauration et fabrication de violons, altos, violoncelles, contrebasses et guitares. Travail à la main, sur rendez-vous."
>
  <section class="container hero" aria-labelledby="hero-title">
    <div class="hero__photo">
      <Photo id="hero" eager sizes="(min-width: 900px) 64vw, 100vw" creditInside />
    </div>
    <div class="hero__text">
      <Etiquette size="lg" maker={false} meta="Normandie" class="hero__label">
        <h1 id="hero-title" class="etq__title">Hugo Abecassis,<span class="etq__kind">luthier</span></h1>
      </Etiquette>
      <p class="hero__sub">Il règle, répare et fabrique des instruments à cordes : violons, altos, violoncelles, contrebasses, guitares.</p>
      <div class="actions">
        <BookingLink />
        <a class="link" href={url('/atelier/')}>Voir l'atelier <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="sf-title">
    <div class="index">
      <div class="index__head">
        <h2 id="sf-title" class="index__title">Ce qu'il fait</h2>
      </div>
      <ul class="index__body jobs">
        {
          services.map((s) => (
            <li>
              <a class="job" href={url(`/savoir-faire/#${s.slug}`)}>
                <span class="job__thumb"><Photo id={thumbs[s.slug]} ratio={4 / 3} sizes="160px" /></span>
                <span class="job__text">
                  <span class="job__title">{s.title}</span>
                  <span class="job__short">{s.short}</span>
                </span>
                <span class="job__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="works-title">
    <div class="index">
      <div class="index__head">
        <h2 id="works-title" class="index__title">Ses instruments</h2>
        <p class="index__intro">Quelques instruments sortis de son établi, des classiques et des idées à lui.</p>
        <a class="link mt" href={url('/savoir-faire/#instruments')}>Tous les instruments <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="index__body works">
        {
          shown.map((c) => (
            <li class="work">
              <Photo id={c.photo!} sizes="(min-width: 900px) 22vw, 50vw" />
              <Etiquette title={c.name} kind={c.type} meta={c.year} size="sm" as="h3" class="work__label" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="trust-title">
    <div class="index">
      <div class="index__head">
        <h2 id="trust-title" class="index__title">Parcours</h2>
      </div>
      <div class="index__body trust">
        <div class="trust__text">
          <p class="lead">Formé en Belgique auprès du luthier Gauthier Louppe. Un premier atelier à Avranches en 2014, puis Saint-Lô depuis 2015.</p>
          <a class="link" href={url('/parcours/')}>Son parcours <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="trust__press">
          <p class="smallcaps muted">Dans la presse</p>
          <PressList items={press.slice(0, 2)} summaries={false} />
        </div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="rdv-title">
    <div class="rdv">
      <h2 id="rdv-title">Un instrument à régler, à réparer, à faire faire&nbsp;?</h2>
      <div class="actions">
        <BookingLink />
        <a class="link" href={url('/contact/#formulaire')}>Écrire à Hugo <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .mt { margin-top: 20px; }

  /* En-tête : la photo, et l'étiquette posée dessus */
  .hero { padding-top: calc(var(--header-h) + 12px); display: grid; }
  .hero__photo { grid-area: 1 / 1; }
  .hero__text { display: grid; justify-items: start; gap: 20px; margin-top: -32px; position: relative; padding-inline: 12px; }
  .hero__sub { max-width: 34ch; font-size: var(--fs-lead); line-height: 1.4; }
  /* Sur mobile, un cadrage carré garde Hugo au centre de l'image */
  @media (max-width: 899px) {
    .hero__photo > :global(.photo) { --ratio: 1 !important; }
  }
  @media (min-width: 900px) {
    .hero { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: end; }
    .hero__photo { grid-column: 1 / 8; grid-row: 1; }
    /* Seule l'étiquette déborde sur la photo (d'une colonne) ; le texte reste sur le fond clair */
    .hero__text { grid-column: 8 / 13; grid-row: 1; margin: 0 0 clamp(24px, 4vw, 56px); padding: 0; }
    .hero__text :global(.hero__label) { margin-left: calc(-1 * ((100% - 4 * var(--col-gap)) / 5 + var(--col-gap))); }
    /* Le crédit passe à gauche : l'étiquette ne le recouvre jamais */
    .hero__photo :global(.photo__credit--inside) { right: auto; left: 10px; }
  }
  @media (min-width: 1200px) {
    .hero__photo { grid-column: 1 / 9; }
    .hero__text { grid-column: 9 / 13; }
    .hero__text :global(.hero__label) { margin-left: calc(-1 * ((100% - 3 * var(--col-gap)) / 4 + var(--col-gap))); }
  }

  /* Ce qu'il fait : un index, pas des cartes */
  .jobs { border-top: 1px solid var(--filet); }
  .job {
    display: grid; grid-template-columns: 96px 1fr auto; gap: 18px; align-items: center;
    padding: 18px 0; border-bottom: 1px solid var(--filet); text-decoration: none; color: inherit;
  }
  .job:hover { color: inherit; background: color-mix(in srgb, var(--papier) 55%, transparent); }
  .job__text { display: grid; gap: 4px; }
  .job__title { font-family: var(--font-display), sans-serif; font-weight: 640; font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem); letter-spacing: -0.03em; line-height: 1.05; }
  .job__short { color: var(--muted); max-width: 46ch; }
  .job__arrow { font-size: 1.3rem; padding-right: 6px; transition: transform 200ms var(--ease); }
  .job:hover .job__arrow { transform: translateX(4px); color: var(--garance); }
  @media (min-width: 700px) { .job { grid-template-columns: 150px 1fr auto; gap: 28px; } }

  /* Instruments : photo + étiquette */
  .works { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px var(--col-gap); }
  .work { position: relative; padding-bottom: 28px; }
  .work:first-child { grid-column: 1 / -1; }
  .work :global(.work__label) { position: absolute; left: 12px; bottom: 0; max-width: calc(100% - 24px); }
  @media (min-width: 900px) {
    .works { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .work:first-child { grid-column: auto; }
  }

  /* Parcours et presse */
  .trust { display: grid; gap: 40px var(--col-gap); }
  .trust__text { display: grid; gap: 18px; justify-items: start; }
  .trust__press { display: grid; gap: 12px; }
  @media (min-width: 900px) { .trust { grid-template-columns: 1fr 1fr; } }

  /* Rendez-vous */
  .rdv { display: grid; gap: 24px; padding: clamp(28px, 5vw, 56px) 0 0; border-top: 1px solid var(--encre); }
  .rdv h2 { font-size: var(--fs-h1); max-width: 18ch; }
</style>
