---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { site } from '../config/site';
import { url, absoluteUrl } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tbc from '../components/Tbc.astro';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  /** Titre complet sans suffixe (accueil). */
  rawTitle?: boolean;
  breadcrumbs?: Crumb[];
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, rawTitle = false, breadcrumbs = [], ogImage = '/og.jpg', jsonLd = [] } = Astro.props;
const { username, events, origin, brand } = site.booking;

const fullTitle = rawTitle ? title : `${title} · Hugo Abecassis, luthier`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = absoluteUrl(ogImage, Astro.site);
const homeUrl = absoluteUrl('/', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${homeUrl}#hugo`,
  name: 'Hugo Abecassis',
  jobTitle: 'Luthier',
  description: "Luthier : entretien, restauration et fabrication d'instruments à cordes. Formé en Belgique auprès de Gauthier Louppe.",
  url: homeUrl,
  knowsAbout: [
    'Lutherie',
    "Restauration d'instruments à cordes",
    "Entretien et réglage d'instruments à cordes",
    "Fabrication d'instruments sur mesure",
    'Violon',
    'Alto',
    'Violoncelle',
    'Contrebasse',
    'Guitare',
  ],
  workLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressRegion: 'Normandie', addressCountry: 'FR' } },
  sameAs: site.sameAs,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeUrl}#site`,
  name: 'Hugo Abecassis, luthier',
  url: homeUrl,
  inLanguage: 'fr-FR',
  about: { '@id': `${homeUrl}#hugo` },
};
const crumbs =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: 'Accueil', path: '/' }, ...breadcrumbs].map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: absoluteUrl(c.path, Astro.site),
        })),
      }
    : null;
const structured = [person, website, ...(crumbs ? [crumbs] : []), ...jsonLd];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="author" content="Hugo Abecassis" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Hugo Abecassis, luthier" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-label" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <div class="string" data-string aria-hidden="true"></div>
    {
      site.conceptMode && (
        <p class="concept-bar small">
          <span>Concept réalisé par Lunixel pour Hugo Abecassis.</span> <span class="muted">Les mentions en rouge restent à valider avec lui.</span>
        </p>
      )
    }
    <div class="page">
      <Header />
      <main id="contenu" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />

    <div hidden data-booking-config data-origin={origin} data-brand={brand}></div>
    {
      !username && (
        <dialog class="booking" aria-labelledby="booking-title" data-booking-dialog>
          <div class="booking__inner">
            <p class="smallcaps">Prendre rendez-vous</p>
            <h2 id="booking-title">Réservation en ligne</h2>
            <p>Ici s'ouvrira l'agenda d'Hugo (Cal.com) : on choisit le type de rendez-vous, puis un créneau.</p>
            <ul class="booking__events">
              {events.map((e) => (
                <li>
                  <span>{e.label}</span>
                  <span class="caption">{e.duration}</span>
                </li>
              ))}
            </ul>
            <p class="small">Compte Cal.com d'Hugo <Tbc note="à créer" /></p>
            <div class="actions">
              <a class="btn" href={url('/contact/#formulaire')}>Écrire à Hugo en attendant</a>
              <button class="link" type="button" data-booking-close>Fermer</button>
            </div>
          </div>
        </dialog>
      )
    }

    <dialog class="lightbox" data-lightbox-dialog aria-label="Image agrandie">
      <button class="lightbox__close link" type="button" data-lightbox-close>Fermer</button>
      <figure class="lightbox__figure">
        <img alt="" data-lightbox-img />
        <figcaption class="caption" data-lightbox-caption></figcaption>
      </figure>
      <div class="lightbox__nav">
        <button type="button" data-lightbox-prev aria-label="Image précédente">←</button>
        <button type="button" data-lightbox-next aria-label="Image suivante">→</button>
      </div>
    </dialog>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
  .page { position: relative; }
  .concept-bar {
    margin: 0; padding: 7px var(--gutter);
    background: var(--encre); color: var(--ivoire);
    text-align: center; line-height: 1.4;
  }
  .concept-bar .muted { color: #cfc8bb; }

  .booking, .lightbox { border: 0; padding: 0; color: var(--encre); }
  .booking { width: min(560px, calc(100% - 32px)); background: var(--etiquette); border: 1px solid var(--encre); }
  .booking::backdrop { background: rgb(27 26 23 / 0.55); }
  .booking__inner { display: grid; gap: 14px; padding: clamp(24px, 4vw, 36px); outline: 1px solid color-mix(in srgb, var(--encre) 55%, transparent); outline-offset: -6px; }
  .booking h2 { font-size: var(--fs-h2); }
  .booking__events { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--filet); }
  .booking__events li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--filet); }
  .booking .link { background: none; border: 0; padding: 0; font: inherit; font-weight: 500; cursor: pointer; }

  .lightbox { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; background: var(--ivoire); }
  .lightbox::backdrop { background: var(--ivoire); }
  .lightbox__close { position: absolute; top: 18px; right: var(--gutter); z-index: 2; background: none; border: 0; padding: 10px 0; font: inherit; font-weight: 500; cursor: pointer; }
  .lightbox__figure { height: 100%; display: grid; place-items: center; align-content: center; gap: 14px; padding: 64px var(--gutter) 96px; }
  .lightbox__figure img { max-height: calc(100svh - 200px); width: auto; object-fit: contain; }
  .lightbox__nav { position: absolute; bottom: 24px; left: 0; right: 0; display: flex; justify-content: center; gap: 12px; }
  .lightbox__nav button { width: 48px; height: 48px; border: 1px solid var(--encre); background: transparent; color: inherit; cursor: pointer; font-size: 1.1rem; }
  .lightbox__nav button:hover { background: var(--encre); color: var(--ivoire); }
</style>
