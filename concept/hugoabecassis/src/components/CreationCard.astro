---
import type { Creation } from '../data/creations';
import Photo from './Photo.astro';
import Tbc from './Tbc.astro';
interface Props { creation: Creation; plate?: string; sizes?: string; headingLevel?: 'h2' | 'h3'; showYearTbc?: boolean }
const { creation: c, plate, sizes = '(min-width: 900px) 33vw, 100vw', headingLevel = 'h3', showYearTbc = false } = Astro.props;
const H = headingLevel;
---

<article class="creation" id={c.slug}>
  <Photo id={c.photo} sizes={sizes} plate={plate} caption={false} />
  <div class="creation__body">
    <p class="label">{c.type}{c.year && ` · ${c.year}`}{!c.year && showYearTbc && <> · <Tbc note="année" /></>}</p>
    <H class="creation__name">{c.name}</H>
    <p class="creation__text">{c.text}</p>
    <dl class="creation__specs">
      {
        c.specs.map((s) => (
          <div>
            <dt class="label">{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</article>

<style>
  .creation { display: grid; gap: 20px; align-content: start; }
  .creation__body { display: grid; gap: 10px; }
  .creation__name { font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.75rem); }
  .creation__text { color: var(--muted); max-width: 44ch; }
  .creation__specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0; margin: 8px 0 0; border-top: 1px solid var(--line); }
  .creation__specs > div { padding: 12px 12px 12px 0; border-bottom: 1px solid var(--line); }
  .creation__specs dd { margin: 4px 0 0; font-size: var(--fs-small); }
</style>
