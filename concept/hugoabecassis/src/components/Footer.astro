---
import { site, nav } from '../config/site';
import { url } from '../lib/url';
import Etiquette from './Etiquette.astro';
import Tbc from './Tbc.astro';
const { email, phone, city, area } = site.contact;
const hasContact = email || phone;
---

<footer class="site-footer tone-papier">
  <div class="container site-footer__grid">
    <div class="site-footer__sig">
      <Etiquette title="Hugo Abecassis" kind="luthier" maker={false} meta={city ? `${city} · ${area}` : area} size="sm" />
      <p class="small muted">Entretien, restauration et fabrication d'instruments à cordes.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Pied de page">
      <ul>
        <li><a href={url('/')}>Accueil</a></li>
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__contact">
      {
        hasContact ? (
          <ul>
            {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
            {phone && <li><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></li>}
          </ul>
        ) : (
          <p class="small">Coordonnées de l'atelier <Tbc /></p>
        )
      }
      <a class="link small" href={url('/contact/#rendez-vous')}>Prendre rendez-vous <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="container site-footer__legal small">
    <ul>
      <li><a href={url('/mentions-legales/')}>Mentions légales</a></li>
      <li><a href={url('/confidentialite/')}>Confidentialité et cookies</a></li>
      <li><a href={url('/conditions/')}>Conditions d'utilisation</a></li>
    </ul>
    <p class="muted">Site conçu par <a href={site.credits.agencyUrl} rel="noopener">{site.credits.agency}</a></p>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(48px, 7vw, 88px) 28px; }
  .site-footer__grid { display: grid; gap: 36px var(--col-gap); }
  .site-footer__sig { display: grid; gap: 14px; justify-items: start; }
  .site-footer__sig p { max-width: 28ch; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .site-footer__nav a, .site-footer__contact a:not(.link) { text-decoration: none; }
  .site-footer__nav a:hover { text-decoration: underline; }
  .site-footer__contact { display: grid; gap: 14px; align-content: start; justify-items: start; }
  .site-footer__legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px;
    margin-top: clamp(40px, 6vw, 72px); padding-top: 20px; border-top: 1px solid var(--filet);
  }
  .site-footer__legal ul { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  @media (min-width: 900px) {
    .site-footer__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .site-footer__sig { grid-column: 1 / 5; }
    .site-footer__nav { grid-column: 6 / 9; }
    .site-footer__contact { grid-column: 9 / 13; }
  }
</style>
