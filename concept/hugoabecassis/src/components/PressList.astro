---
import { press, type PressItem } from '../data/press';
import Tbc from './Tbc.astro';
interface Props { items?: PressItem[]; compact?: boolean; headingLevel?: 'h3' | 'h4' }
const { items = press, compact = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class:list={['press', { 'press--compact': compact }]}>
  {
    items.map((item) => (
      <li class="press__item">
        <div class="press__meta">
          <span class="label">{item.media}</span>
          {item.date ? <time class="label" datetime={item.date}>{item.dateLabel}</time> : <span class="label">{item.dateLabel}</span>}
        </div>
        <H class="press__title">
          <a href={item.url} target="_blank" rel="noopener">
            « {item.title} »<span class="sr-only"> (nouvel onglet)</span>
          </a>
        </H>
        {!compact && (
          <p class="press__summary">
            {item.summary} {item.tbc && <Tbc note={item.tbc} />}
          </p>
        )}
        {!compact && (
          <p class="press__foot small">
            {item.kind && <span class="muted">{item.kind}{item.author ? ` · ${item.author}` : ''}</span>}
            <a class="link" href={item.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              Lire la source <span class="arrow">↗</span>
            </a>
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .press { list-style: none; border-top: 1px solid var(--line); }
  .press__item { display: grid; gap: 10px; padding-block: clamp(22px, 3vw, 36px); border-bottom: 1px solid var(--line); }
  .press__meta { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .press__title { font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem); line-height: 1.18; max-width: 30ch; }
  .press__title a { text-decoration: none; }
  .press__title a:hover { color: var(--accent); }
  .press__summary { color: var(--muted); max-width: 58ch; }
  .press__foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .press--compact .press__title { font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.45rem); }
  @media (min-width: 900px) {
    .press:not(.press--compact) .press__item { grid-template-columns: 220px 1fr; column-gap: 40px; }
    .press:not(.press--compact) .press__meta { flex-direction: column; grid-row: span 3; }
  }
</style>
