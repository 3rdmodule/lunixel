---
import type { PressItem } from '../data/press';
import Tbc from './Tbc.astro';
interface Props { items: PressItem[]; summaries?: boolean }
const { items, summaries = true } = Astro.props;
---

<ul class="press">
  {
    items.map((p) => (
      <li class="press__item">
        <p class="smallcaps press__meta">
          {p.media} · {p.date ? <time datetime={p.date}>{p.dateLabel}</time> : p.dateLabel}
        </p>
        <a class="press__title" href={p.url} rel="noopener" target="_blank">
          {p.title}<span class="sr-only"> (nouvel onglet)</span> <span aria-hidden="true">↗</span>
        </a>
        {summaries && <p class="press__summary">{p.summary} {p.tbc && <Tbc note={p.tbc} />}</p>}
      </li>
    ))
  }
</ul>

<style>
  .press { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--filet); }
  .press__item { display: grid; gap: 6px; padding: 18px 0 20px; border-bottom: 1px solid var(--filet); }
  .press__meta { color: var(--muted); }
  .press__title { font-family: var(--font-display), sans-serif; font-weight: 600; font-size: 1.2rem; line-height: 1.2; letter-spacing: -0.015em; text-decoration: none; max-width: 36ch; }
  .press__title:hover { text-decoration: underline; }
  .press__summary { color: var(--muted); font-size: 0.95rem; max-width: 52ch; }
</style>
