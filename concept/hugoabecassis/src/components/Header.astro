---
import { nav } from '../config/site';
import { url, stripBase } from '../lib/url';
import BookingLink from './BookingLink.astro';

const current = stripBase(Astro.url.pathname);
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={url('/')} class="mark" aria-label="Hugo Abecassis, luthier : accueil">
      <span class="mark__name">Hugo Abecassis</span>
      <span class="mark__role">luthier</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <BookingLink class="site-header__cta" label="Prendre rendez-vous" />
      <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-menu-open>Menu</button>
    </div>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menu" data-menu>
  <div class="container menu__inner">
    <div class="menu__top">
      <a href={url('/')} class="mark"><span class="mark__name">Hugo Abecassis</span><span class="mark__role">luthier</span></a>
      <button class="menu-toggle" type="button" data-menu-close>Fermer</button>
    </div>
    <nav aria-label="Navigation mobile">
      <ul class="menu__list">
        <li><a href={url('/')} aria-current={current === '/' ? 'page' : undefined}>Accueil</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__bottom">
      <BookingLink label="Prendre rendez-vous" />
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
  }
  .site-header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }

  /* Signature : une petite étiquette de luthier */
  .mark {
    display: inline-grid;
    justify-items: center;
    padding: 5px 12px 6px;
    border: 1px solid var(--encre);
    outline: 1px solid color-mix(in srgb, var(--encre) 55%, transparent);
    outline-offset: -4px;
    background: var(--etiquette);
    color: var(--encre);
    text-decoration: none;
    line-height: 1;
  }
  .mark:hover { color: var(--encre); background: #fff; }
  .mark__name { font-family: var(--font-display), sans-serif; font-weight: 650; font-size: 1.02rem; letter-spacing: -0.025em; padding-top: 3px; }
  .mark__role { font-family: var(--font-label), Georgia, serif; font-style: italic; font-size: 0.8rem; margin-top: 2px; color: var(--graphite); }

  .site-nav { display: none; }
  .site-nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(18px, 2.2vw, 36px); }
  .site-nav a { display: inline-block; padding-block: 10px; font-size: 0.95rem; text-decoration: none; }
  .site-nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--garance); text-underline-offset: 0.45em; text-decoration-thickness: 2px; }

  .site-header__actions { display: flex; align-items: center; gap: 12px; }
  .site-header :global(.site-header__cta) { display: none; }

  .menu-toggle {
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--encre);
    background: transparent;
    color: var(--encre);
    font: 500 0.9rem/1 var(--font-sans), sans-serif;
    cursor: pointer;
  }
  .menu-toggle:hover { background: var(--encre); color: var(--ivoire); }

  @media (min-width: 1080px) {
    .site-nav { display: block; }
    .menu-toggle { display: none; }
    .site-header :global(.site-header__cta) { display: inline-flex; min-height: 42px; padding: 10px 18px; }
  }

  /* Menu plein écran */
  .menu { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; border: 0; background: var(--ivoire); color: var(--encre); }
  .menu::backdrop { background: var(--ivoire); }
  .menu__inner { min-height: 100%; display: flex; flex-direction: column; }
  .menu__top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; }
  .menu__list { list-style: none; margin: clamp(24px, 6vh, 56px) 0 0; padding: 0; border-top: 1px solid var(--encre); }
  .menu__list a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--filet);
    font-family: var(--font-display), sans-serif;
    font-weight: 620;
    font-size: clamp(1.7rem, 7vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu__list a[aria-current='page'] { color: var(--garance); }
  .menu__bottom { margin-top: auto; padding-block: 28px 36px; }
  .menu__bottom :global(.btn) { width: 100%; justify-content: center; }
</style>
