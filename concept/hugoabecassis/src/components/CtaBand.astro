---
import BookingLink from './BookingLink.astro';
import { site } from '../config/site';
import { url } from '../lib/url';
interface Props {
  title?: string;
  text?: string;
  motif?: string;
}
const {
  title = 'Parlons de votre instrument.',
  text = "Un réglage, une réparation, un projet d'instrument ? Écrivez quelques lignes, Hugo vous répond.",
  motif,
} = Astro.props;
const email = site.contact.email;
---

<section class="cta tone-nuit" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <span class="ame-divider" aria-hidden="true"></span>
    <h2 id="cta-title" class="display cta__title" data-reveal-text>{title}</h2>
    <p class="cta__text muted">{text}</p>
    <div class="row cta__actions">
      <BookingLink motif={motif} class="cta__btn" />
      {email ? <a class="link" href={`mailto:${email}`}>{email}</a> : <a class="link" href={url('/contact/')}>Écrire à Hugo <span class="arrow" aria-hidden="true">→</span></a>}
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(96px, 14vw, 200px); text-align: center; }
  .cta__inner { display: grid; justify-items: center; gap: var(--space-m); }
  .cta__title { max-width: 12ch; font-size: clamp(2.8rem, 1.6rem + 5vw, 6.5rem); }
  .cta__text { max-width: 44ch; }
  .cta__actions { justify-content: center; margin-top: 8px; }
  .cta :global(.cta__btn) { background: var(--ivoire); color: var(--encre); border-color: var(--ivoire); }
  .cta :global(.cta__btn:hover) { background: var(--garance-clair); border-color: var(--garance-clair); color: var(--nuit); }
</style>
