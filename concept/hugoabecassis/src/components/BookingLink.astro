---
/**
 * Bouton « Prendre rendez-vous ».
 * - mode "request" : lien vers le formulaire (motif pré-rempli).
 * - mode "cal"     : même lien (repli sans JS) ; le script ouvre Cal.com en fenêtre modale.
 */
import { site } from '../config/site';
import { url } from '../lib/url';

interface Props {
  motif?: string;
  variant?: 'btn' | 'ghost' | 'link' | 'small';
  label?: string;
  class?: string;
}
const { motif, variant = 'btn', label = 'Prendre rendez-vous', class: className } = Astro.props;
const href = url(`/contact/${motif ? `?motif=${encodeURIComponent(motif)}` : ''}#rendez-vous`);
const cls = {
  btn: 'btn',
  ghost: 'btn btn--ghost',
  small: 'btn btn--small',
  link: 'link',
}[variant];
const calLink = site.booking.mode === 'cal' && site.booking.calLink ? site.booking.calLink : undefined;
---

<a href={href} class:list={[cls, className]} data-booking={calLink ? '' : undefined} data-cal-link={calLink}>
  <span>{label}</span><span class="arrow" aria-hidden="true">→</span>
</a>
