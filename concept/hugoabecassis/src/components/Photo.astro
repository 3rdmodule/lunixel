---
/**
 * Photo : <picture> AVIF/WebP responsive, légende en Caslon italique,
 * crédit du photographe quand la photo n'est pas d'Hugo.
 * Sans fichier : cadre discret qui décrit la prise de vue à faire.
 * Aucune animation d'apparition.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos, type PhotoId, type PhotoSlot } from '../data/photos';

interface Props {
  id: PhotoId;
  sizes?: string;
  eager?: boolean;
  /** Remplit son parent (position absolue). */
  fill?: boolean;
  /** true : légende du manifeste ; texte : légende libre. */
  caption?: boolean | string;
  ratio?: number;
  lightbox?: boolean;
  /** Crédit posé sur la photo (au lieu de dessous). */
  creditInside?: boolean;
  class?: string;
}

const { id, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, fill = false, caption = false, ratio, lightbox = false, creditInside = false, class: className } = Astro.props;

const slot = photos[id] as PhotoSlot;
const loaders = {
  ...import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/**/*.{jpg,jpeg,png,webp,avif}'),
  ...import.meta.glob<{ default: ImageMetadata }>('/photos-sources/**/*.{jpg,jpeg,png,webp}'),
};
const loader = slot.file ? (loaders[`/src/assets/photos/${slot.file}`] ?? loaders[`/photos-sources/${slot.file}`]) : undefined;
const image = loader ? (await loader()).default : undefined;

const r = ratio ?? slot.ratio;
const captionText = typeof caption === 'string' ? caption : caption ? slot.caption : undefined;
const credit = image && slot.photographer ? `Photo ${slot.photographer.name}` : undefined;
const widths = image ? [360, 540, 720, 960, 1280, 1600].filter((w) => w < image.width) : [];
if (image) widths.push(image.width);
const style = `--ratio: ${r}; ${slot.focus ? `--focus: ${slot.focus};` : ''}`;
---

<figure class:list={['photo', { 'photo--fill': fill }, className]} style={style}>
  <div class="photo__frame">
    {
      image ? (
        <Picture
          src={image}
          alt={slot.alt}
          widths={widths}
          sizes={sizes}
          formats={['avif', 'webp']}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      ) : (
        <div class="shot" role="img" aria-label={slot.alt}>
          <span class="smallcaps">Photo à faire</span>
          <span class="shot__brief">{slot.brief}</span>
        </div>
      )
    }
    {credit && creditInside && <span class="photo__credit photo__credit--inside">{credit}</span>}
    {
      lightbox && image && (
        <button
          class="photo__zoom"
          type="button"
          data-lightbox
          data-full={image.src}
          data-caption={[captionText ?? slot.caption ?? slot.alt, credit].filter(Boolean).join(' · ')}
          aria-label={`Agrandir : ${slot.alt}`}
        />
      )
    }
  </div>
  {
    (captionText || (credit && !fill && !creditInside)) && (
      <figcaption class="photo__caption">
        {captionText && <span class="caption">{captionText}</span>}
        {credit && !creditInside && <span class="photo__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .photo__zoom { position: absolute; inset: 0; width: 100%; border: 0; padding: 0; background: transparent; cursor: zoom-in; }
  .photo__zoom:focus-visible { outline-offset: -4px; }
  .photo__credit--inside { position: absolute; top: 10px; right: 10px; z-index: 1; padding: 3px 7px; background: rgb(250 247 239 / 0.85); color: var(--encre); }
</style>
