---
/**
 * Photo éditoriale.
 * - Si le fichier existe dans src/assets/photos/ : <picture> AVIF/WebP responsive.
 * - Sinon (phase concept) : cadre de prise de vue qui décrit la photo attendue.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photos, type PhotoId } from '../data/photos';

interface Props {
  id: PhotoId;
  sizes?: string;
  eager?: boolean;
  fill?: boolean;
  caption?: boolean | string;
  plate?: string;
  ratio?: number;
  compact?: boolean;
  lightbox?: boolean;
  class?: string;
}

const {
  id,
  sizes = '(min-width: 1200px) 50vw, 100vw',
  eager = false,
  fill = false,
  caption = false,
  plate,
  ratio,
  compact = false,
  lightbox = false,
  class: className,
} = Astro.props;

const slot = photos[id];
// Chargement paresseux : seules les images réellement utilisées sont traitées.
const loaders = {
  ...import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG}'),
  ...import.meta.glob<{ default: ImageMetadata }>('/photos-sources/**/*.{jpg,jpeg,png,webp,JPG,JPEG}'),
};
const loader = slot.file ? loaders[`/src/assets/photos/${slot.file}`] ?? loaders[`/photos-sources/${slot.file}`] : undefined;
const image = loader ? (await loader()).default : undefined;

const r = ratio ?? slot.ratio;
const tone = 'tone' in slot ? slot.tone : 'light';
const focus = 'focus' in slot ? slot.focus : undefined;
const captionText = typeof caption === 'string' ? caption : slot.caption;
const widths = image ? [480, 768, 1080, 1440, 1920, 2560].filter((w) => w <= image.width) : [];
if (image && (widths.length === 0 || widths[widths.length - 1] < image.width)) widths.push(image.width);
const style = `--ratio: ${r}; ${focus ? `--focus: ${focus};` : ''}`;
---

<figure class:list={['photo', { 'photo--fill': fill }, className]} data-reveal style={style}>
  <div class="photo__frame">
    {
      image ? (
        <Picture
          src={image}
          alt={slot.alt}
          widths={widths}
          sizes={sizes}
          formats={['avif', 'webp']}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding={eager ? 'sync' : 'async'}
        />
      ) : (
        <div class:list={['shot', { 'shot--dark': tone === 'dark', 'shot--compact': compact }]} role="img" aria-label={slot.alt}>
          <span class="shot__label mono" aria-hidden="true">Prise de vue à réaliser</span>
          <span class="shot__brief" aria-hidden="true">{slot.brief}</span>
        </div>
      )
    }
    {
      lightbox && (
        <button
          class="photo__zoom"
          type="button"
          data-lightbox
          data-full={image ? image.src : ''}
          data-caption={captionText ?? slot.alt}
          data-brief={image ? '' : slot.brief}
          aria-label={`Agrandir : ${slot.alt}`}
        />
      )
    }
  </div>
  {
    captionText && !fill && (
      <figcaption class="photo__caption">
        <span class="label">{captionText}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .photo__zoom {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .photo__zoom:focus-visible { outline-offset: -4px; }
</style>
